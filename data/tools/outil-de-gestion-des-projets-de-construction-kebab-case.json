{
  "id": "outil-de-gestion-des-projets-de-construction-kebab-case",
  "title": "Outil de gestion des projets de construction (BTP)",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "nomDuProjet",
      "type": "text",
      "label": "Nom du projet :",
      "placeholder": "Exemple : Construction d'un immeuble",
      "required": true
    },
    {
      "name": "budgetAlloue",
      "type": "number",
      "label": "Budget alloué :",
      "placeholder": "Exemple : 1 000 000 €",
      "required": true
    },
    {
      "name": "typeDeProjet",
      "type": "select",
      "options": [
        "Réalisations",
        "Réhabilitations",
        "Nouvelles constructions"
      ],
      "label": "Type de projet :",
      "placeholder": "Exemple : Réalisations",
      "required": true
    },
    {
      "name": "descriptionDuProjet",
      "type": "textarea",
      "label": "Description du projet :",
      "placeholder": "Exemple : Construction d'un immeuble de 10 étages avec 50 logements",
      "required": true
    },
    {
      "name": "responsableDuProjet",
      "type": "text",
      "label": "Responsable du projet :",
      "placeholder": "Exemple : Pierre Dupont",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nom du projet : {nomDuProjet}, Budget alloué : {budgetAlloue} €, Type de projet : {typeDeProjet}, Description du projet : {descriptionDuProjet}, Responsable du projet : {responsableDuProjet}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}