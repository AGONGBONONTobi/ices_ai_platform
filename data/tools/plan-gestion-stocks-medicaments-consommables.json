{
  "id": "plan-gestion-stocks-medicaments-consommables",
  "title": "Plan de gestion des stocks de médicaments & consommables",
  "category": "SUPPLY CHAIN & ACHATS",
  "inputs": [
    {
      "name": "variable1",
      "type": "number",
      "label": "Taille de l'entrepôt (en mètres carrés)",
      "placeholder": "Ex: 500",
      "required": true
    },
    {
      "name": "variable2",
      "type": "select",
      "options": [
        "Hebdomadaire",
        "Bihebdomadaire",
        "Mensuelle",
        "Trimestrielle"
      ],
      "label": "Fréquence des réapprovisionnements",
      "placeholder": "Choisissez une option",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Description des procédures actuelles de gestion des stocks",
      "placeholder": "Ex: ...",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Niveau de stock critique (en jours de consommation)",
      "placeholder": "Ex: 30",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Principaux fournisseurs et conditions de livraison",
      "placeholder": "Ex: Fournisseur A, délai 3 jours",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
