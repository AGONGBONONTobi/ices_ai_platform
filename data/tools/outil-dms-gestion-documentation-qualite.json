{
  "id": "outil-dms-gestion-documentation-qualite",
  "title": "Outil de gestion de la documentation qualité (DMS)",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "variable1",
      "type": "number",
      "label": "Nombre de documents de qualité gérés",
      "placeholder": "ex: 120",
      "required": true
    },
    {
      "name": "variable2",
      "type": "select",
      "options": [
        "Très élevé",
        "Élevé",
        "Moyen",
        "Faible",
        "Très faible"
      ],
      "label": "Niveau de conformité des documents",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Principaux défis rencontrés",
      "placeholder": "ex: versioning, accès, archivage",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Outils de collaboration utilisés",
      "placeholder": "ex: SharePoint, Confluence",
      "required": false
    },
    {
      "name": "variable5",
      "type": "select",
      "options": [
        "Quotidien",
        "Hebdomadaire",
        "Mensuel",
        "Trimestriel",
        "Annuel"
      ],
      "label": "Fréquence de mise à jour des documents",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
