{
  "id": "template-de-plan-de-communication-projet",
  "title": "Template de plan de communication projet",
  "category": "TEMPLATES & MODÈLES PRÊTS À L'EMPLOI",
  "inputs": [
    {
      "name": "nomDuProjet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet de développement de nouveaux produits",
      "required": true
    },
    {
      "name": "objectifDuProjet",
      "type": "textarea",
      "label": "Objectif du projet",
      "placeholder": "Exemple : Développer un nouveau produit pour répondre à la demande croissante du marché",
      "required": true
    },
    {
      "name": "publicCible",
      "type": "select",
      "options": [
        "Équipe de direction",
        "Équipe de développement",
        "Équipe de vente",
        "Tous"
      ],
      "label": "Public cible",
      "placeholder": "Exemple : Équipe de direction",
      "required": true
    },
    {
      "name": "canalDeCommunication",
      "type": "select",
      "options": [
        "Réunion mensuelle",
        "Courriel",
        "Site intranet",
        "Tous"
      ],
      "label": "Canal de communication",
      "placeholder": "Exemple : Réunion mensuelle",
      "required": true
    },
    {
      "name": "frequanceDeCommunication",
      "type": "number",
      "label": "Fréquence de communication",
      "placeholder": "Exemple : 1 fois par semaine",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nom du projet : {nomDuProjet}, Objectif du projet : {objectifDuProjet}, Public cible : {publicCible}, Canal de communication : {canalDeCommunication}, Fréquence de communication : {frequanceDeCommunication}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
