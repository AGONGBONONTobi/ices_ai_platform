{
  "id": "strategie-de-diversification-et-de-pivot",
  "title": "Stratégie de diversification & de pivot",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "domaine",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie"
      ],
      "label": "Domaine d'activité",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "objectifs",
      "type": "textarea",
      "label": "Objectifs de diversification et de pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Ressources disponibles pour la diversification et le pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Niveau de risque associé à la diversification et au pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Domaine: {domaine}, Objectifs: {objectifs}, Ressources: {ressources}, Risques: {risques}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
