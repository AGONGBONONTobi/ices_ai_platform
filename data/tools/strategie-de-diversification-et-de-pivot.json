{
  "id": "strategie-de-diversification-et-de-pivot",
  "title": "Stratégie de diversification & de pivot",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "domaine",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie"
      ],
      "label": "Domaine d'activité",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "objectifs",
      "type": "textarea",
      "label": "Objectifs de diversification et de pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Ressources disponibles pour la diversification et le pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Niveau de risque associé à la diversification et au pivot",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Domaine: {domaine}, Objectifs: {objectifs}, Ressources: {ressources}, Risques: {risques}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}