{
  "id": "analyse-dependance-critique-aux-fournisseurs",
  "title": "Analyse de la dépendance critique aux fournisseurs",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "nomFournisseur",
      "type": "text",
      "label": "Nom du fournisseur",
      "placeholder": "Exemple : XYZ Inc.",
      "required": true
    },
    {
      "name": "pourcentageDependance",
      "type": "number",
      "label": "Pourcentage de dépendance",
      "placeholder": "Exemple : 80",
      "required": true
    },
    {
      "name": "typeContrat",
      "type": "select",
      "options": [
        "Contrat à durée déterminée",
        "Contrat à durée indéterminée"
      ],
      "label": "Type de contrat",
      "placeholder": "Exemple : Contrat à durée déterminée",
      "required": true
    },
    {
      "name": "zoneActivite",
      "type": "textarea",
      "label": "Zone d'activité du fournisseur",
      "placeholder": "Exemple : Production de composants électroniques",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des risques. L'utilisateur a répondu : Nom du fournisseur : {nomFournisseur}, Pourcentage de dépendance : {pourcentageDependance}%, Type de contrat : {typeContrat}, Zone d'activité du fournisseur : {zoneActivite}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
