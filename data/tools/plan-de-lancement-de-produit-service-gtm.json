{
  "id": "plan-de-lancement-de-produit-service-gtm",
  "title": "Plan de lancement de produit/service (GTM)",
  "category": "MARKETING & COMMERCIAL",
  "inputs": [
    {
      "name": "nomDuProduit",
      "type": "text",
      "label": "Nom du produit/service",
      "placeholder": "Exemple : Produit X",
      "required": true
    },
    {
      "name": "descriptionDuProduit",
      "type": "textarea",
      "label": "Description du produit/service",
      "placeholder": "Exemple : C'est un produit qui...",
      "required": true
    },
    {
      "name": "objectifDeVente",
      "type": "number",
      "label": "Objectif de vente (en €)",
      "placeholder": "Exemple : 100 000",
      "required": true
    },
    {
      "name": "canalDeVente",
      "type": "select",
      "options": [
        "Site web",
        "Réseaux sociaux",
        "Email marketing",
        "Publicité en ligne"
      ],
      "label": "Canal de vente principal",
      "placeholder": "Exemple : Site web",
      "required": true
    },
    {
      "name": "budgetAlloue",
      "type": "number",
      "label": "Budget alloué (en €)",
      "placeholder": "Exemple : 50 000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nom du produit/service : {nomDuProduit}, Description du produit/service : {descriptionDuProduit}, Objectif de vente : {objectifDeVente} €, Canal de vente principal : {canalDeVente}, Budget alloué : {budgetAlloue} €.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
