{
  "id": "outil-de-quantification-des-risques-monte-carlo",
  "title": "Outil de quantification des risques (Monte Carlo)",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "nomProjet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet de développement logiciel",
      "required": true
    },
    {
      "name": "typeRisque",
      "type": "select",
      "options": [
        "Risque opérationnel",
        "Risque financier",
        "Risque de crédit"
      ],
      "label": "Type de risque",
      "required": true
    },
    {
      "name": "descriptionRisque",
      "type": "textarea",
      "label": "Description du risque",
      "placeholder": "Exemple : Le projet peut être retardé en raison de problèmes techniques",
      "required": true
    },
    {
      "name": "probabiliteRisque",
      "type": "number",
      "label": "Probabilité du risque (en %)",
      "placeholder": "Exemple : 20",
      "required": true
    },
    {
      "name": "impactRisque",
      "type": "number",
      "label": "Impact du risque (en €)",
      "placeholder": "Exemple : 10000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert en gestion des risques. L'utilisateur a répondu : Nom du projet : {nomProjet}, Type de risque : {typeRisque}, Description du risque : {descriptionRisque}, Probabilité du risque : {probabiliteRisque}%, Impact du risque : {impactRisque}€.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
