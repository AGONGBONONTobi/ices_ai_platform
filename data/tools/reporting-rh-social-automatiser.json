{
  "id": "reporting-rh-social-automatiser",
  "title": "Reporting RH & social automatisé",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "periode",
      "type": "select",
      "options": [
        "Mois en cours",
        "Mois précédent",
        "Trimestre en cours",
        "Année en cours"
      ],
      "label": "Sélectionnez la période pour le rapport",
      "placeholder": "",
      "required": true
    },
    {
      "name": "societe",
      "type": "text",
      "label": "Nom de la société",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "type_de_reporting",
      "type": "select",
      "options": [
        "Rapport mensuel",
        "Rapport trimestriel",
        "Rapport annuel"
      ],
      "label": "Sélectionnez le type de rapport",
      "placeholder": "",
      "required": true
    },
    {
      "name": "donnees_supp",
      "type": "textarea",
      "label": "Données supplémentaires",
      "placeholder": "Exemple de réponse",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Période: {periode}, Société: {societe}, Type de rapport: {type_de_reporting}, Données supplémentaires: {donnees_supp}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
