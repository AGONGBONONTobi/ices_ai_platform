{
  "id": "outil-de-gestion-de-projets-d-innovation-stage-gate",
  "title": "Outil de gestion de projets d'innovation (Stage-Gate)",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "nomDuProjet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Développement d'un nouveau produit",
      "required": true
    },
    {
      "name": "descriptionDuProjet",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Exemple : Développement d'un nouveau produit pour répondre à une opportunité de marché",
      "required": true
    },
    {
      "name": "objectifsDuProjet",
      "type": "select",
      "options": [
        "Réduire les coûts",
        "Augmenter les ventes",
        "Améliorer la qualité"
      ],
      "label": "Objectifs du projet",
      "placeholder": "Exemple : Réduire les coûts",
      "required": true
    },
    {
      "name": "equipeDuProjet",
      "type": "text",
      "label": "Équipe du projet",
      "placeholder": "Exemple : 5 personnes",
      "required": true
    },
    {
      "name": "budgetDuProjet",
      "type": "number",
      "label": "Budget du projet",
      "placeholder": "Exemple : 100 000 €",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nom du projet : {nomDuProjet}, Description du projet : {descriptionDuProjet}, Objectifs du projet : {objectifsDuProjet}, Équipe du projet : {equipeDuProjet}, Budget du projet : {budgetDuProjet}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
