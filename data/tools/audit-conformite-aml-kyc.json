{
  "id": "audit-conformite-aml-kyc",
  "title": "Audit de conformité AML/KYC (anti-blanchiment)",
  "category": "AUDITS & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "activite",
      "type": "textarea",
      "label": "Description de l'activité de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "pays",
      "type": "select",
      "options": [
        "France",
        "Belgique",
        "Suisse",
        "Autre"
      ],
      "label": "Pays d'implantation de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "clients",
      "type": "number",
      "label": "Nombre de clients de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "operations",
      "type": "textarea",
      "label": "Description des opérations financières de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en AML/KYC. L'utilisateur a répondu : Entreprise: {entreprise}, Activité: {activite}, Pays: {pays}, Nombre de clients: {clients}, Opérations financières: {operations}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}