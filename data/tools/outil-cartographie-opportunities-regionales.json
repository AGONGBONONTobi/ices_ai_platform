{
  "id": "outil-cartographie-opportunities-regionales",
  "title": "Outil de cartographie des opportunités d'affaires régionales",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "region",
      "type": "select",
      "options": [
        "Nord",
        "Sud",
        "Est",
        "Ouest"
      ],
      "label": "Quelle région souhaitez-vous cartographier ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "secteur",
      "type": "text",
      "label": "Quel secteur d'activité souhaitez-vous cibler ?",
      "placeholder": "Exemple : technologie, santé, finance",
      "required": true
    },
    {
      "name": "description_opportunite",
      "type": "textarea",
      "label": "Décrivez brièvement l'opportunité d'affaires que vous souhaitez explorer :",
      "placeholder": "Exemple : développement d'un nouveau produit, expansion sur un marché existant",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique. L'utilisateur a répondu : Région: {region}, Secteur: {secteur}, Description de l'opportunité: {description_opportunite}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
