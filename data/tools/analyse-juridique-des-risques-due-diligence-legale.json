{
  "id": "analyse-juridique-des-risques-due-diligence-legale",
  "title": "Analyse juridique des risques & due diligence légale",
  "category": "JURIDIQUE & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Finance",
        "Technologie",
        "Énergie",
        "Autres"
      ],
      "label": "Secteur d'activité de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "objectif",
      "type": "textarea",
      "label": "Objectif de l'analyse juridique",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "réglementations",
      "type": "select",
      "options": [
        "RGPD",
        "LCA",
        "Autres"
      ],
      "label": "Réglementations applicables",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques",
      "type": "textarea",
      "label": "Risques identifiés",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en droit. L'utilisateur a répondu : Entreprise: {entreprise}, Secteur: {secteur}, Objectif: {objectif}, Réglementations: {réglementations}, Risques: {risques}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}