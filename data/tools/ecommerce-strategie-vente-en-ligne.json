      "options": [
        "Facebook",
        "Instagram",
        "Google Ads",
        "Email marketing"
      ],
      "label": "Quel canal de communication préférez-vous ?",
      "placeholder": "Sélectionnez une option",
      "required": true
    },
    {
      "name": "budget",
