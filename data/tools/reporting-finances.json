{
  "id": "reporting-finances",
  "title": "Reporting IFRS / OHADA / SYSCOHADA / normes locales",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de nom d'entreprise",
      "required": true
    },
    {
      "name": "région",
      "type": "select",
      "options": [
        "Afrique de l'Ouest",
        "Afrique Centrale",
        "Afrique du Nord",
        "Europe",
        "Amérique du Nord"
      ],
      "label": "Région géographique",
      "placeholder": "Sélectionnez une région",
      "required": true
    },
    {
      "name": "norme",
      "type": "select",
      "options": [
        "IFRS",
        "OHADA",
        "SYSCOHADA",
        "normes locales"
      ],
      "label": "Norme comptable",
      "placeholder": "Sélectionnez une norme",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Description du reporting",
      "placeholder": "Exemple de description",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un expert en reporting financier. L'utilisateur a répondu : Entreprise: {entreprise}, Région: {région}, Norme: {norme}, Description: {description}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
