{
  "id": "reporting-finances",
  "title": "Reporting IFRS / OHADA / SYSCOHADA / normes locales",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de nom d'entreprise",
      "required": true
    },
    {
      "name": "région",
      "type": "select",
      "options": [
        "Afrique de l'Ouest",
        "Afrique Centrale",
        "Afrique du Nord",
        "Europe",
        "Amérique du Nord"
      ],
      "label": "Région géographique",
      "placeholder": "Sélectionnez une région",
      "required": true
    },
    {
      "name": "norme",
      "type": "select",
      "options": [
        "IFRS",
        "OHADA",
        "SYSCOHADA",
        "normes locales"
      ],
      "label": "Norme comptable",
      "placeholder": "Sélectionnez une norme",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Description du reporting",
      "placeholder": "Exemple de description",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un expert en reporting financier. L'utilisateur a répondu : Entreprise: {entreprise}, Région: {région}, Norme: {norme}, Description: {description}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
