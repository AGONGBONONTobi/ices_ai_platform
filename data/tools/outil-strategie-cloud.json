{
  "id": "outil-strategie-cloud",
  "title": "Stratégie cloud, migration & architecture",
  "category": "TRANSFORMATION DIGITALE & IA",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple d'entreprise",
      "required": true
    },
    {
      "name": "objectif_migration",
      "type": "select",
      "options": [
        "Réduction des coûts",
        "Amélioration de la flexibilité",
        "Mise à l'échelle",
        "Autre"
      ],
      "label": "Objectif de la migration vers le cloud",
      "placeholder": "Choisissez un objectif",
      "required": true
    },
    {
      "name": "description_architecture",
      "type": "textarea",
      "label": "Description de l'architecture actuelle",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "avantages_esperes",
      "type": "textarea",
      "label": "Avantages espérés de la migration vers le cloud",
      "placeholder": "Exemple d'avantages",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise : {entreprise}, Objectif de migration : {objectif_migration}, Description de l'architecture actuelle : {description_architecture}, Avantages espérés : {avantages_esperes}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
