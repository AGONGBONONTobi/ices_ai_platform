{
  "id": "outil-strategie-cloud",
  "title": "Stratégie cloud, migration & architecture",
  "category": "TRANSFORMATION DIGITALE & IA",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple d'entreprise",
      "required": true
    },
    {
      "name": "objectif_migration",
      "type": "select",
      "options": [
        "Réduction des coûts",
        "Amélioration de la flexibilité",
        "Mise à l'échelle",
        "Autre"
      ],
      "label": "Objectif de la migration vers le cloud",
      "placeholder": "Choisissez un objectif",
      "required": true
    },
    {
      "name": "description_architecture",
      "type": "textarea",
      "label": "Description de l'architecture actuelle",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "avantages_esperes",
      "type": "textarea",
      "label": "Avantages espérés de la migration vers le cloud",
      "placeholder": "Exemple d'avantages",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise : {entreprise}, Objectif de migration : {objectif_migration}, Description de l'architecture actuelle : {description_architecture}, Avantages espérés : {avantages_esperes}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
