{
  "id": "comptabilite-analytique-centres-de-couts",
  "title": "Comptabilité analytique & centres de coûts",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "centre-de-couts",
      "type": "select",
      "options": [
        "Produit",
        "Service",
        "Département"
      ],
      "label": "Type de centre de coûts",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "revenus",
      "type": "number",
      "label": "Revenus totaux",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "depenses",
      "type": "number",
      "label": "Dépenses totales",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Description détaillée du centre de coûts",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en comptabilité analytique. L'utilisateur a fourni les informations suivantes : Entreprise : {entreprise}, Centre de coûts : {centre-de-couts}, Revenus totaux : {revenus}, Dépenses totales : {depenses}, Description détaillée du centre de coûts : {description}. Analyse ces informations et fournis un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}