  "title": "Comptabilité analytique & centres de coûts",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "centre-de-couts",
      "type": "select",
      "options": [
        "Produit",
        "Service",
        "Département"
      ],
      "label": "Type de centre de coûts",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "revenus",
      "type": "number",
      "label": "Revenus totaux",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "depenses",
      "type": "number",
      "label": "Dépenses totales",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Description détaillée du centre de coûts",
      "placeholder": "Exemple de réponse",
      "required": true
    }
