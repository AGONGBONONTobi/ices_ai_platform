{
  "id": "analyse-des-risques-de-conformite-et-reglementaires",
  "title": "Analyse des risques de conformité & réglementaires",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Finance",
        "Santé",
        "Environnement",
        "Autres"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques_identifies",
      "type": "textarea",
      "label": "Risques identifiés (liste)",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "mesures_prises",
      "type": "textarea",
      "label": "Mesures prises pour atténuer les risques",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "budget_alloue",
      "type": "number",
      "label": "Budget alloué pour la conformité",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des risques. L'utilisateur a répondu : Entreprise: {entreprise}, Secteur: {secteur}, Risques identifiés: {risques_identifies}, Mesures prises: {mesures_prises}, Budget alloué: {budget_alloue}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
