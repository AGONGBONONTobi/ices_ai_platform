{
  "id": "outil-d-evaluation-et-notation-esg",
  "title": "Outil d'évaluation & notation ESG",
  "category": "RSE & DÉVELOPPEMENT DURABLE",
  "inputs": [
    {
      "name": "esg_score",
      "type": "number",
      "label": "Score ESG attribué par l'entreprise",
      "placeholder": "Exemple de score",
      "required": true
    },
    {
      "name": "emissions_carbone",
      "type": "number",
      "label": "Émissions de gaz à effet de serre (tonnes CO2 équivalent)",
      "placeholder": "Exemple d'émissions",
      "required": true
    },
    {
      "name": "diversite_emploi",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Niveau de diversité dans l'emploi",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "engagement_citoyen",
      "type": "textarea",
      "label": "Engagement citoyen et responsabilité sociale de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en RSE. L'utilisateur a répondu : ESG Score: {esg_score}, Émissions de gaz à effet de serre : {emissions_carbone} tonnes CO2 équivalent, Niveau de diversité dans l'emploi : {diversite_emploi}, Engagement citoyen : {engagement_citoyen}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
