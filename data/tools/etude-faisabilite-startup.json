{
  "id": "etude-faisabilite-startup",
  "title": "Étude de faisabilité d'une start-up",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Nom de la start-up",
      "placeholder": "Exemple : TechNova",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Description du produit ou service",
      "placeholder": "Exemple : Plateforme de gestion de tâches basée sur l'IA",
      "required": true
    },
    {
      "name": "variable3",
      "type": "text",
      "label": "Marché cible",
      "placeholder": "Exemple : PME du secteur SaaS",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Idée",
        "Prototype",
        "Produit fini",
        "En croissance"
      ],
      "label": "État de développement",
      "placeholder": "Sélectionnez l'état actuel",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
