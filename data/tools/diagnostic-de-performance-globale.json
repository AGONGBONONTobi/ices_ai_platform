{
  "id": "diagnostic-de-performance-globale",
  "title": "Diagnostic de performance globale (BSC)",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "indicateursPerformance",
      "type": "textarea",
      "label": "Indicateurs de performance",
      "placeholder": "Exemple : Indicateurs de performance financiers, indicateurs de performance non financiers",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en diagnostic de performance globale. Utilise {indicateursPerformance} pour évaluer la performance globale de l'entreprise.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
