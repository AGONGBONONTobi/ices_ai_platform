{
  "id": "plan-communication-rse-impact",
  "title": "Plan de communication RSE & impact",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Interne",
        "Externe",
        "Mixte"
      ],
      "label": "Type de communication",
      "placeholder": "Sélectionnez le type",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Objectifs RSE",
      "placeholder": "Décrivez les objectifs RSE de votre plan",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Budget alloué (en €)",
      "placeholder": "Entrez le budget en euros",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Date de lancement prévue",
      "placeholder": "JJ/MM/AAAA",
      "required": true
    },
    {
      "name": "variable5",
      "type": "select",
      "options": [
        "Employés",
        "Clients",
        "Partenaires",
        "Grand public"
      ],
      "label": "Public cible",
      "placeholder": "Sélectionnez le public cible",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}