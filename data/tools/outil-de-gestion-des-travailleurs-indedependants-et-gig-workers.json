{
  "id": "outil-de-gestion-des-travailleurs-indedependants-et-gig-workers",
  "title": "Outil de gestion des travailleurs indépendants & gig workers",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "type-de-travail",
      "type": "select",
      "options": [
        "Développeur",
        "Designeur",
        "Consultant",
        "Autre"
      ],
      "label": "Quel type de travail effectuez-vous ?",
      "placeholder": "Sélectionnez un type de travail",
      "required": true
    },
    {
      "name": "nombre-heures-travaillees",
      "type": "number",
      "label": "Combien d'heures travaillez-vous par semaine ?",
      "placeholder": "Entrez le nombre d'heures",
      "required": true
    },
    {
      "name": "niveau-de-satisfaction",
      "type": "textarea",
      "label": "Quels sont vos points forts et faibles dans votre travail ?",
      "placeholder": "Décrivez vos points forts et faibles",
      "required": true
    },
    {
      "name": "demandes-de-soutien",
      "type": "textarea",
      "label": "Avez-vous besoin de soutien ou de ressources supplémentaires ?",
      "placeholder": "Décrivez vos besoins",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Type de travail: {type-de-travail}, Nombre d'heures travaillées: {nombre-heures-travaillees}, Niveau de satisfaction: {niveau-de-satisfaction}, Demandes de soutien: {demandes-de-soutien}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
