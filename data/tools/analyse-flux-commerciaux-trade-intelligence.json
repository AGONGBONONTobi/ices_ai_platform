{
  "id": "analyse-flux-commerciaux-trade-intelligence",
  "title": "Analyse des flux commerciaux & trade intelligence",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteurActivite",
      "type": "select",
      "options": [
        "Agriculture",
        "Industrie manufacturière",
        "Services",
        "Technologie"
      ],
      "label": "Secteur d'activité de l'entreprise",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "descriptionFlux",
      "type": "textarea",
      "label": "Description détaillée des flux commerciaux",
      "placeholder": "Entrez une description détaillée",
      "required": true
    },
    {
      "name": "zoneGeographique",
      "type": "text",
      "label": "Zone géographique concernée",
      "placeholder": "Exemple : Europe, Asie, Amérique du Nord",
      "required": true
    },
    {
      "name": "objectifAnalyse",
      "type": "text",
      "label": "Objectif principal de l'analyse",
      "placeholder": "Exemple : Identifier les opportunités de croissance",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique. L'utilisateur a fourni les informations suivantes : Secteur d'activité : {secteurActivite}, Description des flux commerciaux : {descriptionFlux}, Zone géographique : {zoneGeographique}, Objectif de l'analyse : {objectifAnalyse}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
