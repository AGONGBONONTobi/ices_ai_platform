{
  "id": "bilan-social-automatise-preparation-nao",
  "title": "Bilan social automatisé & préparation NAO",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple : XYZ",
      "required": true
    },
    {
      "name": "effectif",
      "type": "number",
      "label": "Effectif de l'entreprise",
      "placeholder": "Exemple : 100",
      "required": true
    },
    {
      "name": "salaire-moyen",
      "type": "number",
      "label": "Salaire moyen de l'entreprise",
      "placeholder": "Exemple : 4000",
      "required": true
    },
    {
      "name": "type-contrat",
      "type": "select",
      "options": [
        "CDI",
        "CDD",
        "INTÉrim"
      ],
      "label": "Type de contrat principal",
      "placeholder": "Exemple : CDI",
      "required": true
    },
    {
      "name": "taux-chomage",
      "type": "number",
      "label": "Taux de chômage dans la région",
      "placeholder": "Exemple : 10",
      "required": true
    },
    {
      "name": "description-probleme",
      "type": "textarea",
      "label": "Description du problème à résoudre",
      "placeholder": "Exemple : Nous avons des difficultés à trouver des candidats qualifiés",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Effectif: {effectif}, Salaire moyen: {salaire-moyen}, Type de contrat principal: {type-contrat}, Taux de chômage dans la région: {taux-chomage}, Description du problème à résoudre: {description-probleme}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
