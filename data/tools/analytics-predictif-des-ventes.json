{
  "id": "analytics-predictif-des-ventes",
  "title": "Analytics prédictif des ventes",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "periode",
      "type": "select",
      "options": [
        "Mois",
        "Trimestre",
        "Année"
      ],
      "label": "Sélectionnez la période de temps",
      "placeholder": "",
      "required": true
    },
    {
      "name": "produit",
      "type": "select",
      "options": [
        "Produit A",
        "Produit B",
        "Produit C"
      ],
      "label": "Sélectionnez le produit",
      "placeholder": "",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Entrez le budget prévisionnel",
      "placeholder": "0",
      "required": true
    },
    {
      "name": "volumes",
      "type": "textarea",
      "label": "Entrez les volumes de vente",
      "placeholder": "",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Période: {periode}, Produit: {produit}, Budget: {budget}, Volumes: {volumes}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
