{
  "id": "strategie-communication-post-crise-reconstruction",
  "title": "Stratégie de communication post-crise & reconstruction",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Catastrophe naturelle",
        "Cyberattaque",
        "Scandale médiatique",
        "Autre"
      ],
      "label": "Quel type de crise avez-vous traversé?",
      "placeholder": "Sélectionnez le type",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Décrivez brièvement la crise et son impact",
      "placeholder": "Exemple: ...",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Quel budget avez-vous alloué (en €)?",
      "placeholder": "Exemple: 50000",
      "required": true
    },
    {
      "name": "variable4",
      "type": "textarea",
      "label": "Quels sont vos objectifs principaux pour la reconstruction de l'image?",
      "placeholder": "Exemple: Rétablir la confiance",
      "required": true
    },
    {
      "name": "variable5",
      "type": "select",
      "options": [
        "Médias traditionnels",
        "Réseaux sociaux",
        "Relations presse",
        "Communautés locales",
        "Autre"
      ],
      "label": "Quels canaux privilégiez-vous?",
      "placeholder": "Sélectionnez",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}