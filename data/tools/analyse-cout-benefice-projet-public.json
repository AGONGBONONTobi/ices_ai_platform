{
  "id": "analyse-cout-benefice-projet-public",
  "title": "Analyse coût-bénéfice (ACB) de projet public",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "number",
      "label": "Budget alloué (en €)",
      "placeholder": "2000000",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Décrire brièvement le projet",
      "required": true
    },
    {
      "name": "variable3",
      "type": "select",
      "options": [
        "Infrastructure",
        "Éducation",
        "Santé",
        "Environnement"
      ],
      "label": "Type de projet",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Durée estimée (en mois)",
      "placeholder": "12",
      "required": true
    },
    {
      "name": "variable5",
      "type": "text",
      "label": "Nom du responsable",
      "placeholder": "Jean Dupont",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}