{
  "id": "analyse-cout-benefice-projet-public",
  "title": "Analyse coût-bénéfice (ACB) de projet public",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "number",
      "label": "Budget alloué (en €)",
      "placeholder": "2000000",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Décrire brièvement le projet",
      "required": true
    },
    {
      "name": "variable3",
      "type": "select",
      "options": [
        "Infrastructure",
        "Éducation",
        "Santé",
        "Environnement"
      ],
      "label": "Type de projet",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Durée estimée (en mois)",
      "placeholder": "12",
      "required": true
    },
    {
      "name": "variable5",
      "type": "text",
      "label": "Nom du responsable",
      "placeholder": "Jean Dupont",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
