{
  "id": "etude-faisabilite-infrastructure-publique",
  "title": "Étude de faisabilité d'une infrastructure publique",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Infrastructure routière",
        "Infrastructure ferroviaire",
        "Infrastructure d'eau",
        "Infrastructure énergétique"
      ],
      "label": "Quel type d'infrastructure publique est évalué ?",
      "placeholder": "Sélectionnez un type",
      "required": true
    },
    {
      "name": "variable2",
      "type": "number",
      "label": "Budget estimé (en millions d'euros)",
      "placeholder": "Ex: 120",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Description détaillée du projet",
      "placeholder": "Décrivez le projet, ses objectifs, son périmètre",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Localisation géographique (ville/région)",
      "placeholder": "Ex: Lyon",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}