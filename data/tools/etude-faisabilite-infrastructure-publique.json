{
  "id": "etude-faisabilite-infrastructure-publique",
  "title": "Étude de faisabilité d'une infrastructure publique",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Infrastructure routière",
        "Infrastructure ferroviaire",
        "Infrastructure d'eau",
        "Infrastructure énergétique"
      ],
      "label": "Quel type d'infrastructure publique est évalué ?",
      "placeholder": "Sélectionnez un type",
      "required": true
    },
    {
      "name": "variable2",
      "type": "number",
      "label": "Budget estimé (en millions d'euros)",
      "placeholder": "Ex: 120",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Description détaillée du projet",
      "placeholder": "Décrivez le projet, ses objectifs, son périmètre",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Localisation géographique (ville/région)",
      "placeholder": "Ex: Lyon",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
