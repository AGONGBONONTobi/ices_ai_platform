{
  "id": "outil-de-suivi-et-reporting-chantier",
  "title": "Outil de suivi & reporting chantier",
  "category": "OUTILS SECTORIELS SPÉCIALISÉS",
  "inputs": [
    {
      "name": "nom_chantier",
      "type": "text",
      "label": "Nom du chantier",
      "placeholder": "Exemple : Construction de la nouvelle bibliothèque",
      "required": true
    },
    {
      "name": "etat_avancement",
      "type": "select",
      "options": [
        "En cours de planification",
        "En cours de construction",
        "Terminé"
      ],
      "label": "État d'avancement du chantier",
      "placeholder": "",
      "required": true
    },
    {
      "name": "commentaires",
      "type": "textarea",
      "label": "Commentaires et remarques sur le chantier",
      "placeholder": "Exemple : Retards prévus, problèmes rencontrés...",
      "required": false
    },
    {
      "name": "budget_alloué",
      "type": "number",
      "label": "Budget alloué pour le chantier",
      "placeholder": "100000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion de projet. L'utilisateur a répondu : Nom du chantier : {nom_chantier}, État d'avancement : {etat_avancement}, Commentaires : {commentaires}, Budget alloué : {budget_alloué}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
