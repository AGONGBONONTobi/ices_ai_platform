{
  "id": "indicateurs-clés-de-risque-et-alertes",
  "title": "Indicateurs clés de risque (KRI) & alertes",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "type_risque",
      "type": "select",
      "options": [
        "Financier",
        "Opérationnel",
        "Stratégique",
        "Technologique"
      ],
      "label": "Quel type de risque souhaitez-vous évaluer ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description_risque",
      "type": "textarea",
      "label": "Décrivez brièvement le risque identifié",
      "placeholder": "Exemple : Perte de données sensibles",
      "required": true
    },
    {
      "name": "seuil_alerte",
      "type": "number",
      "label": "Quel seuil d'alerte souhaitez-vous définir ?",
      "placeholder": "Exemple : 10%",
      "required": true
    },
    {
      "name": "frequance_vérification",
      "type": "select",
      "options": [
        "Journalière",
        "Hebdomadaire",
        "Mensuelle"
      ],
      "label": "Combien de fois souhaitez-vous vérifier ce KRI ?",
      "placeholder": "",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des risques. L'utilisateur a répondu : Type de risque : {type_risque}, Description du risque : {description_risque}, Seuil d'alerte : {seuil_alerte}, Fréquence de vérification : {frequance_vérification}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}