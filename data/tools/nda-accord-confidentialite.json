{
  "id": "nda-accord-confidentialite",
  "title": "Template de NDA & accord de confidentialité",
  "category": "JURIDIQUE & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise qui signe l'accord",
      "placeholder": "Exemple : XYZ Corporation",
      "required": true
    },
    {
      "name": "partenaire",
      "type": "text",
      "label": "Nom du partenaire avec qui l'accord est signé",
      "placeholder": "Exemple : ABC Inc.",
      "required": true
    },
    {
      "name": "objet",
      "type": "textarea",
      "label": "Objet de l'accord de confidentialité",
      "placeholder": "Exemple : Partage de documents sensibles",
      "required": true
    },
    {
      "name": "duree",
      "type": "select",
      "options": [
        "Indéfinie",
        "Définie (spécifier la date)"
      ],
      "label": "Durée de l'accord de confidentialité",
      "placeholder": "Exemple : Indéfinie",
      "required": true
    },
    {
      "name": "revisions",
      "type": "select",
      "options": [
        "Accepté",
        "Refusé"
      ],
      "label": "Acceptation des révisions",
      "placeholder": "Exemple : Accepté",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un conseiller juridique. L'utilisateur a répondu : Entreprise : {entreprise}, Partenaire : {partenaire}, Objet : {objet}, Durée : {duree}, Révisions : {revisions}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}