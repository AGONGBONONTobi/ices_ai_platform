{
  "id": "outil-de-veille-des-appels-doffres-et-marches-publics",
  "title": "Outil de veille des appels d'offres & marchés publics",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Bâtiment et travaux publics",
        "Informatique et télécommunications",
        "Services",
        "Autres"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Description de l'appel d'offre ou du marché public",
      "placeholder": "Entrez une description détaillée",
      "required": true
    },
    {
      "name": "date_limite",
      "type": "text",
      "label": "Date limite de réponse",
      "placeholder": "YYYY-MM-DD",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Budget estimé",
      "placeholder": "Entrez un montant",
      "required": false
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique et veille. L'utilisateur a répondu : Secteur: {secteur}, Description: {description}, Date limite: {date_limite}, Budget: {budget}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
