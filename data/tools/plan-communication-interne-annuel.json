{
  "id": "plan-communication-interne-annuel",
  "title": "Plan de communication interne annuel",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "textarea",
      "label": "Quels sont les objectifs principaux de votre plan de communication interne?",
      "placeholder": "Exemple: renforcer la cohésion d'équipe, informer sur les nouvelles politiques",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Qui sont les principaux publics internes visés?",
      "placeholder": "Exemple: employés, managers, équipes projet",
      "required": true
    },
    {
      "name": "variable3",
      "type": "select",
      "options": [
        "Email",
        "Intranet",
        "Réunions d'équipe",
        "Affichage interne",
        "Newsletter interne",
        "Autre"
      ],
      "label": "Quels canaux utiliserez-vous?",
      "placeholder": "Sélectionnez un ou plusieurs canaux",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Quel est le budget alloué (en €)?",
      "placeholder": "Exemple: 5000",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Quel est le calendrier prévu pour les différentes phases?",
      "placeholder": "Exemple: Janvier - lancement, Février - suivi",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
