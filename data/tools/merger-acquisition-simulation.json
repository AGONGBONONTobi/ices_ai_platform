{
  "id": "merger-acquisition-simulation",
  "title": "Simulation de fusion-acquisition (M&A)",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "entreprise_vendue",
      "type": "text",
      "label": "Nom de l'entreprise à vendre",
      "placeholder": "Exemple : XYZ Corporation",
      "required": true
    },
    {
      "name": "montant_vente",
      "type": "number",
      "label": "Montant de la vente (en millions de dollars)",
      "placeholder": "Exemple : 500",
      "required": true
    },
    {
      "name": "methode_de_finance",
      "type": "select",
      "options": [
        "Emprunt",
        "Actionnariat",
        "Capital-investissement"
      ],
      "label": "Méthode de financement utilisée",
      "placeholder": "Exemple : Emprunt",
      "required": true
    },
    {
      "name": "risques_identifies",
      "type": "textarea",
      "label": "Risques identifiés pendant la transaction",
      "placeholder": "Exemple : Risque de non-respect des délais, risque de non-remboursement des emprunts",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise à vendre : {entreprise_vendue}, Montant de la vente : {montant_vente} millions de dollars, Méthode de financement utilisée : {methode_de_finance}, Risques identifiés : {risques_identifies}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
