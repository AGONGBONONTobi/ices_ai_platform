{
  "id": "etude-faisabilite-projet-touristique",
  "title": "Étude de faisabilité d'un projet touristique",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "project_name",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Ex: Tourisme de montagne",
      "required": true
    },
    {
      "name": "location",
      "type": "text",
      "label": "Localisation géographique",
      "placeholder": "Ex: Alpes françaises",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Budget prévu (en euros)",
      "placeholder": "Ex: 500000",
      "required": true
    },
    {
      "name": "target_audience",
      "type": "textarea",
      "label": "Public cible",
      "placeholder": "Ex: Familles, voyageurs d'affaires, etc.",
      "required": true
    },
    {
      "name": "environmental_impact",
      "type": "select",
      "options": [
        "Faible",
        "Modéré",
        "Élevé"
      ],
      "label": "Impact environnemental prévu",
      "placeholder": "Sélectionnez",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Project name: {project_name}, Location: {location}, Budget: {budget}, Target audience: {target_audience}, Environmental impact: {environmental_impact}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
