{
  "id": "strategie-relations-mediques-presse",
  "title": "Stratégie de relations médias & presse",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple: ABC Corp",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Objectifs principaux de la campagne",
      "placeholder": "Exemple: Augmenter la notoriété",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Budget annuel alloué (en €)",
      "placeholder": "Exemple: 50000",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Presse locale",
        "Presse nationale",
        "Presse internationale",
        "Blogs spécialisés"
      ],
      "label": "Canaux de diffusion privilégiés",
      "placeholder": "Choisissez un ou plusieurs",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}