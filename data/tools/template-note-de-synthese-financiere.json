{
  "id": "template-note-de-synthese-financiere",
  "title": "Template de note de synthèse financière",
  "category": "TEMPLATES & MODÈLES PRÊTS À L'EMPLOI",
  "inputs": [
    {
      "name": "bilan-comptable",
      "type": "textarea",
      "label": "Bilan comptable",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "flux-de-trésorerie",
      "type": "textarea",
      "label": "Flux de trésorerie",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "ratio-financiers",
      "type": "select",
      "options": [
        "ROE",
        "ROA",
        "Rapport de trésorerie"
      ],
      "label": "Ratio financiers",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "recommandations",
      "type": "textarea",
      "label": "Recommandations",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant financier. L'utilisateur a répondu : Bilan comptable: {bilan-comptable}, Flux de trésorerie: {flux-de-trésorerie}, Ratio financiers: {ratio-financiers}, Recommandations: {recommandations}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
