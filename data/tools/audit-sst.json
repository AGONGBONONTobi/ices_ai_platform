{
  "id": "audit-sst",
  "title": "Audit de la santé & sécurité au travail (SST)",
  "category": "AUDITS & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "nombre-employes",
      "type": "number",
      "label": "Nombre d'employés",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "type-d-activite",
      "type": "select",
      "options": [
        "Fabrication",
        "Services",
        "Commerce",
        "Autre"
      ],
      "label": "Type d'activité de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques-principaux",
      "type": "textarea",
      "label": "Risques principaux identifiés dans l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "mesures-de-sécurité",
      "type": "textarea",
      "label": "Mesures de sécurité mises en place dans l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en SST. L'utilisateur a répondu : Entreprise: {entreprise}, Nombre d'employés: {nombre-employes}, Type d'activité: {type-d-activite}, Risques principaux: {risques-principaux}, Mesures de sécurité: {mesures-de-sécurité}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
