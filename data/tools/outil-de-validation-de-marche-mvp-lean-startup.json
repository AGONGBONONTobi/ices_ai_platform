{
  "id": "outil-de-validation-de-marche-mvp-lean-startup",
  "title": "Outil de validation de marché (MVP & lean startup)",
  "category": "OUTILS SECTORIELS SPÉCIALISÉS",
  "inputs": [
    {
      "name": "produit_description",
      "type": "textarea",
      "label": "Décrivez votre produit ou service",
      "placeholder": "Description du produit",
      "required": true
    },
    {
      "name": "cible",
      "type": "select",
      "options": [
        "Particuliers",
        "Entreprises",
        "Institutions"
      ],
      "label": "Quelle est votre cible principale ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "concurrentiels",
      "type": "text",
      "label": "Quels sont vos principaux concurrents ?",
      "placeholder": "Liste des concurrents",
      "required": true
    },
    {
      "name": "objectif",
      "type": "number",
      "label": "Quel est votre objectif de part de marché ?",
      "placeholder": "Pourcentage",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert en validation de marché. L'utilisateur a répondu : Produit: {produit_description}, Cible: {cible}, Concurrents: {concurrentiels}, Objectif de part de marché: {objectif}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
