{
  "id": "programme-de-reverse-mentoring",
  "title": "Programme de reverse mentoring",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "mentee",
      "type": "text",
      "label": "Nom du mentoré",
      "placeholder": "Exemple : John Doe",
      "required": true
    },
    {
      "name": "menteur",
      "type": "text",
      "label": "Nom du mentor",
      "placeholder": "Exemple : Jane Doe",
      "required": true
    },
    {
      "name": "domaine",
      "type": "select",
      "options": [
        "Leadership",
        "Communication",
        "Innovation",
        "Technologie"
      ],
      "label": "Domaine de reverse mentoring",
      "placeholder": "Exemple : Leadership",
      "required": true
    },
    {
      "name": "objectifs",
      "type": "textarea",
      "label": "Objectifs du programme de reverse mentoring",
      "placeholder": "Exemple : Améliorer la communication entre les équipes",
      "required": true
    },
    {
      "name": "duree",
      "type": "number",
      "label": "Durée du programme (en mois)",
      "placeholder": "Exemple : 6",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Mentoré : {mentee}, Mentor : {menteur}, Domaine : {domaine}, Objectifs : {objectifs}, Durée : {duree}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
