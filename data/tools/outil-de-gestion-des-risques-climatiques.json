{
  "id": "outil-de-gestion-des-risques-climatiques",
  "title": "Outil de gestion des risques climatiques (TCFD/TNFD)",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "zone-geographique",
      "type": "select",
      "options": [
        "Europe",
        "Amérique du Nord",
        "Asie",
        "Afrique",
        "Amérique du Sud"
      ],
      "label": "Quelle zone géographique est-elle concernée ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "type-de-risque",
      "type": "select",
      "options": [
        "Risque de changement climatique",
        "Risque de pollution",
        "Risque de dégradation de l'environnement"
      ],
      "label": "Quel type de risque est-elle concerné ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description-du-risque",
      "type": "textarea",
      "label": "Décrivez brièvement le risque identifié",
      "placeholder": "",
      "required": true
    },
    {
      "name": "mesures-de-mitigation",
      "type": "textarea",
      "label": "Quelles mesures de mitigation sont envisagées pour atténuer ce risque ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "budget-alloue",
      "type": "number",
      "label": "Quel est le budget alloué pour ces mesures de mitigation ?",
      "placeholder": "",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des risques climatiques. L'utilisateur a répondu : Zone géographique : {zone-geographique}, Type de risque : {type-de-risque}, Description du risque : {description-du-risque}, Mesures de mitigation : {mesures-de-mitigation}, Budget alloué : {budget-alloue}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
