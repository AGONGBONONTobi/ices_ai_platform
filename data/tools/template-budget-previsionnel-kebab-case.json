{
  "id": "template-budget-previsionnel-kebab-case",
  "title": "Template de budget prévisionnel",
  "category": "TEMPLATES & MODÈLES PRÊTS À L'EMPLOI",
  "inputs": [
    {
      "name": "revenus-previsionnels",
      "type": "number",
      "label": "Revenus prévisionnels (en €)",
      "placeholder": "Entrez vos revenus prévisionnels",
      "required": true
    },
    {
      "name": "depenses-previsionnelles",
      "type": "number",
      "label": "Dépenses prévisionnelles (en €)",
      "placeholder": "Entrez vos dépenses prévisionnelles",
      "required": true
    },
    {
      "name": "taux-de-marge",
      "type": "number",
      "label": "Taux de marge souhaité (en %)",
      "placeholder": "Entrez votre taux de marge souhaité",
      "required": true
    },
    {
      "name": "type-de-budget",
      "type": "select",
      "options": [
        "Personnel",
        "Opérationnel",
        "Investissement"
      ],
      "label": "Type de budget",
      "placeholder": "Choisissez le type de budget",
      "required": true
    },
    {
      "name": "periode-previsionnelle",
      "type": "textarea",
      "label": "Période prévisionnelle",
      "placeholder": "Décrivez la période prévisionnelle",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion financière. L'utilisateur a répondu : Revenus prévisionnels : {revenus-previsionnels}, Dépenses prévisionnelles : {depenses-previsionnelles}, Taux de marge : {taux-de-marge}, Type de budget : {type-de-budget}, Période prévisionnelle : {periode-previsionnelle}. Analyse ces informations et propose un budget prévisionnel équilibré.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}