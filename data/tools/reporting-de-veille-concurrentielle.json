{
  "id": "reporting-de-veille-concurrentielle",
  "title": "Reporting de veille concurrentielle",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise concurrente",
      "placeholder": "Exemple : Amazon",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Energie"
      ],
      "label": "Secteur d'activité de l'entreprise concurrente",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "strategie",
      "type": "textarea",
      "label": "Stratégie de l'entreprise concurrente",
      "placeholder": "Exemple : Développement de nouveaux produits",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Effectif de l'entreprise concurrente",
      "placeholder": "Exemple : 1000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise : {entreprise}, Secteur : {secteur}, Stratégie : {strategie}, Ressources : {ressources}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
