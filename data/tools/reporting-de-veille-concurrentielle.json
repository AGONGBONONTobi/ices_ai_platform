{
  "id": "reporting-de-veille-concurrentielle",
  "title": "Reporting de veille concurrentielle",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise concurrente",
      "placeholder": "Exemple : Amazon",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Energie"
      ],
      "label": "Secteur d'activité de l'entreprise concurrente",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "strategie",
      "type": "textarea",
      "label": "Stratégie de l'entreprise concurrente",
      "placeholder": "Exemple : Développement de nouveaux produits",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Effectif de l'entreprise concurrente",
      "placeholder": "Exemple : 1000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise : {entreprise}, Secteur : {secteur}, Stratégie : {strategie}, Ressources : {ressources}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}