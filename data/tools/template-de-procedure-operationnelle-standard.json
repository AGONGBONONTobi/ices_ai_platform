{
  "id": "template-de-procedure-operationnelle-standard",
  "title": "Template de procédure opérationnelle standard (SOP)",
  "category": "TEMPLATES & MODÈLES PRÊTS À L'EMPLOI",
  "inputs": [
    {
      "name": "procedureName",
      "type": "text",
      "label": "Nom de la procédure",
      "placeholder": "Exemple : Gestion des stocks",
      "required": true
    },
    {
      "name": "procedureDescription",
      "type": "textarea",
      "label": "Description de la procédure",
      "placeholder": "Exemple : Cette procédure décrit les étapes pour gérer les stocks de produits",
      "required": true
    },
    {
      "name": "procedureType",
      "type": "select",
      "options": [
        "Gestion des stocks",
        "Gestion des ressources humaines",
        "Gestion des finances"
      ],
      "label": "Type de procédure",
      "required": true
    },
    {
      "name": "frequency",
      "type": "select",
      "options": [
        "Quotidien",
        "Hebdomadaire",
        "Mensuel",
        "Trimestriel"
      ],
      "label": "Fréquence d'exécution de la procédure",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un consultant expert en procédures opérationnelles. L'utilisateur a fourni les informations suivantes : Nom de la procédure : {procedureName}, Description : {procedureDescription}, Type de procédure : {procedureType}, Fréquence d'exécution : {frequency}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
