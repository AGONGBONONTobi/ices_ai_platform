{
  "id": "outil-rse-africain",
  "title": "Programme RSE adapté aux contextes africains",
  "category": "RSE & DÉVELOPPEMENT DURABLE",
  "inputs": [
    {
      "name": "contexte",
      "type": "select",
      "options": [
        "Urbain",
        "Rural",
        "Mixte"
      ],
      "label": "Quel est le contexte géographique du programme RSE ?",
      "placeholder": "Sélectionnez un contexte",
      "required": true
    },
    {
      "name": "objectifs",
      "type": "textarea",
      "label": "Quels sont les objectifs principaux du programme RSE ?",
      "placeholder": "Décrivez les objectifs du programme",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Quelles sont les ressources allouées au programme RSE ?",
      "placeholder": "Entrez le montant des ressources",
      "required": true
    },
    {
      "name": "partenaires",
      "type": "select",
      "options": [
        "Gouvernement",
        "Organisations internationales",
        "Associations locales"
      ],
      "label": "Quels sont les partenaires principaux du programme RSE ?",
      "placeholder": "Sélectionnez les partenaires",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en RSE. L'utilisateur a répondu : Contexte: {contexte}, Objectifs: {objectifs}, Ressources: {ressources}, Partenaires: {partenaires}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
