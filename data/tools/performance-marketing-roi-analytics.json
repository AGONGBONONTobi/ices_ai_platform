{
  "id": "performance-marketing-roi-analytics",
  "title": "Analytics de la performance marketing (ROI)",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "budget",
      "type": "number",
      "label": "Budget alloué pour la campagne",
      "placeholder": "Exemple : 10000",
      "required": true
    },
    {
      "name": "revenus",
      "type": "number",
      "label": "Revenus générés par la campagne",
      "placeholder": "Exemple : 15000",
      "required": true
    },
    {
      "name": "marge",
      "type": "number",
      "label": "Marge bénéficiaire de la campagne",
      "placeholder": "Exemple : 5000",
      "required": true
    },
    {
      "name": "canal-de-revenus",
      "type": "select",
      "options": [
        "Email",
        "Réseaux sociaux",
        "Publicité en ligne"
      ],
      "label": "Canal de revenus principal",
      "placeholder": "Exemple : Email",
      "required": true
    },
    {
      "name": "commentaires-client",
      "type": "textarea",
      "label": "Commentaires des clients sur la campagne",
      "placeholder": "Exemple : Les clients ont apprécié la campagne",
      "required": false
    }
  ],
  "promptTemplate": "Analyse de la performance marketing (ROI) : Tu es un expert en marketing. L'utilisateur a répondu : Budget : {budget}, Revenus : {revenus}, Marge : {marge}, Canal de revenus principal : {canal-de-revenus}, Commentaires des clients : {commentaires-client}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
