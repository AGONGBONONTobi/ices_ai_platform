{
  "id": "outil-de-mesure-de-la-notoriete-brand-equity",
  "title": "Outil de mesure de la notoriété & brand equity",
  "category": "MARKETING & COMMERCIAL",
  "inputs": [
    {
      "name": "marque",
      "type": "text",
      "label": "Nom de la marque",
      "placeholder": "Exemple : Nike",
      "required": true
    },
    {
      "name": "annee",
      "type": "number",
      "label": "Année de référence",
      "placeholder": "Exemple : 2022",
      "required": true
    },
    {
      "name": "region",
      "type": "select",
      "options": [
        "Europe",
        "Amérique du Nord",
        "Asie",
        "Afrique"
      ],
      "label": "Région géographique",
      "placeholder": "Exemple : Europe",
      "required": true
    },
    {
      "name": "media",
      "type": "textarea",
      "label": "Liste des médias utilisés pour la promotion de la marque",
      "placeholder": "Exemple : Facebook, Instagram, TV, Presse écrite",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Budget alloué à la promotion de la marque",
      "placeholder": "Exemple : 100 000€",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en marketing. L'utilisateur a répondu : Marque : {marque}, Année : {annee}, Région : {region}, Médias : {media}, Budget : {budget}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
