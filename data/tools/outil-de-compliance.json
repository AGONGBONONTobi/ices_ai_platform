{
  "id": "outil-de-compliance",
  "title": "Outil de compliance CIMA, UEMOA, CEMAC, OHADA",
  "category": "JURIDIQUE & CONFORMITÉ",
  "inputs": [
    {
      "name": "pays",
      "type": "select",
      "options": [
        "Côte d'Ivoire",
        "Sénégal",
        "Guinée",
        "Bénin",
        "Togo",
        "Burkina Faso",
        "Niger",
        "Mali",
        "Guinée-Bissau",
        "Sénégal",
        "Cameroun",
        "République centrafricaine",
        "République du Congo",
        "Gabon",
        "Guinée équatoriale",
        "Centrafrique"
      ],
      "label": "Sélectionner le pays",
      "placeholder": "",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Banque",
        "Assurance",
        "Finance",
        "Énergie",
        "Industrie",
        "Agriculture",
        "Tourisme",
        "Autres"
      ],
      "label": "Sélectionner le secteur",
      "placeholder": "",
      "required": true
    },
    {
      "name": "type_d_action",
      "type": "select",
      "options": [
        "Création d'une entreprise",
        "Fusion-acquisition",
        "Scission",
        "Modification du statut",
        "Autres"
      ],
      "label": "Sélectionner le type d'action",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Décrire l'opération",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "documents",
      "type": "text",
      "label": "Lister les documents",
      "placeholder": "Exemple de liste de documents",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en conformité. L'utilisateur a sélectionné le pays {pays}, le secteur {secteur}, le type d'action {type_d_action}, a décrit l'opération {description} et a listé les documents {documents}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
