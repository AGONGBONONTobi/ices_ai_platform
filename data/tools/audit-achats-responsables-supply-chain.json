{
  "id": "audit-achats-responsables-supply-chain",
  "title": "Audit des achats responsables & supply chain",
  "category": "AUDITS & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Alimentaire",
        "Électronique",
        "Textile",
        "Autre"
      ],
      "label": "Secteur d'activité de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "provenance",
      "type": "textarea",
      "label": "Provenance des produits (matières premières, fournisseurs, etc.)",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "certifications",
      "type": "select",
      "options": [
        "ISO 9001",
        "ISO 14001",
        "OHSAS 18001",
        "Autre"
      ],
      "label": "Certifications existantes (ISO 9001, ISO 14001, OHSAS 18001, etc.)",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "risques",
      "type": "textarea",
      "label": "Risques identifiés dans la chaîne d'approvisionnement (défauts de qualité, retards de livraison, etc.)",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Secteur: {secteur}, Provenance: {provenance}, Certifications: {certifications}, Risques: {risques}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}