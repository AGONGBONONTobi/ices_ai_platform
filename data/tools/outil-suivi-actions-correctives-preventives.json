{
  "id": "outil-suivi-actions-correctives-preventives",
  "title": "Outil de suivi des actions correctives & préventives",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "nombre_actions",
      "type": "number",
      "label": "Nombre total d'actions correctives et préventives",
      "placeholder": "Ex: 12",
      "required": true
    },
    {
      "name": "duree_moyenne",
      "type": "number",
      "label": "Durée moyenne de résolution (en jours)",
      "placeholder": "Ex: 5",
      "required": true
    },
    {
      "name": "type_action",
      "type": "select",
      "options": [
        "Corrective",
        "Préventive",
        "Amélioration"
      ],
      "label": "Type d'action principale",
      "placeholder": "",
      "required": true
    },
    {
      "name": "responsable",
      "type": "text",
      "label": "Responsable principal",
      "placeholder": "Ex: Jean Dupont",
      "required": true
    },
    {
      "name": "description_action",
      "type": "textarea",
      "label": "Description détaillée des actions",
      "placeholder": "Ex: ...",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nombre d'actions: {nombre_actions}, Durée moyenne: {duree_moyenne}, Type d'action: {type_action}, Responsable: {responsable}, Description: {description_action}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
