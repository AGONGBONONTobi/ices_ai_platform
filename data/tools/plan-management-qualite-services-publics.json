{
  "id": "plan-management-qualite-services-publics",
  "title": "Plan de management de la qualité dans les services publics",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Initial",
        "Répetable",
        "Défini",
        "Gestioné",
        "Optimisé"
      ],
      "label": "Quel est le niveau de maturité actuel de votre service en matière de qualité?",
      "placeholder": "Sélectionnez un niveau",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Décrivez les processus clés à améliorer",
      "placeholder": "Exemple: traitement des demandes citoyennes",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Budget annuel (en €)",
      "placeholder": "Ex: 50000",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Taux de satisfaction client",
        "Temps de traitement",
        "Taux de conformité",
        "Coût par incident"
      ],
      "label": "Indicateur de performance principal",
      "placeholder": "Sélectionnez",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Contraintes ou obstacles",
      "placeholder": "Ex: manque de personnel",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}