{
  "id": "outil-de-gestion-de-la-connaissance-projet",
  "title": "Outil de gestion de la connaissance projet (KB)",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "nomDuProjet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet XYZ",
      "required": true
    },
    {
      "name": "descriptionDuProjet",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Exemple : Projet de développement d'une nouvelle application",
      "required": true
    },
    {
      "name": "responsableDuProjet",
      "type": "text",
      "label": "Responsable du projet",
      "placeholder": "Exemple : John Doe",
      "required": true
    },
    {
      "name": "prioriteDuProjet",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Elevé"
      ],
      "label": "Priorité du projet",
      "placeholder": "Exemple : Faible",
      "required": true
    },
    {
      "name": "dureeEstimeeDuProjet",
      "type": "number",
      "label": "Durée estimée du projet",
      "placeholder": "Exemple : 12",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Nom du projet : {nomDuProjet}, Description du projet : {descriptionDuProjet}, Responsable du projet : {responsableDuProjet}, Priorité du projet : {prioriteDuProjet}, Durée estimée du projet : {dureeEstimeeDuProjet}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
