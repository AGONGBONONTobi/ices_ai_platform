{
  "id": "analyse-compétitivité-nationale-territoriale",
  "title": "Analyse de la compétitivité nationale & territoriale",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "pays",
      "type": "text",
      "label": "Quel pays souhaitez-vous analyser ?",
      "placeholder": "Exemple : France",
      "required": true
    },
    {
      "name": "région",
      "type": "select",
      "options": [
        "Europe de l'Ouest",
        "Europe de l'Est",
        "Amérique du Nord",
        "Amérique du Sud",
        "Asie",
        "Afrique"
      ],
      "label": "Quelle région géographique correspond à votre pays ?",
      "placeholder": "Sélectionnez une région",
      "required": true
    },
    {
      "name": "industrie",
      "type": "textarea",
      "label": "Quelles sont les principales industries présentes dans votre pays ?",
      "placeholder": "Exemple : technologie, énergie, agriculture, etc.",
      "required": true
    },
    {
      "name": "score-innovation",
      "type": "number",
      "label": "Quel est le score d'innovation de votre pays (sur 100) ?",
      "placeholder": "Exemple : 80",
      "required": true
    },
    {
      "name": "score-investissement",
      "type": "number",
      "label": "Quel est le score d'investissement de votre pays (sur 100) ?",
      "placeholder": "Exemple : 70",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Pays: {pays}, Région: {région}, Industries: {industrie}, Score innovation: {score-innovation}, Score investissement: {score-investissement}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
