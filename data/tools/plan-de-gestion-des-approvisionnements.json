{
  "id": "plan-de-gestion-des-approvisionnements",
  "title": "Plan de gestion des approvisionnements",
  "category": "SUPPLY CHAIN & ACHATS",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Ex: Société XYZ",
      "required": true
    },
    {
      "name": "variable2",
      "type": "number",
      "label": "Nombre de fournisseurs actuels",
      "placeholder": "Ex: 15",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Principaux critères de sélection des fournisseurs",
      "placeholder": "Ex: Qualité, coût, délai",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Très satisfaisant",
        "Satisfaisant",
        "Moyen",
        "Insuffisant"
      ],
      "label": "État actuel de la gestion des stocks",
      "placeholder": "Sélectionnez",
      "required": true
    },
    {
      "name": "variable5",
      "type": "number",
      "label": "Objectif de réduction des coûts d'approvisionnement (%)",
      "placeholder": "Ex: 10",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
