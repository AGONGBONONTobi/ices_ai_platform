{
  "id": "diagnostic-strategique",
  "title": "Diagnostic stratégique (SWOT augmenté IA)",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "forces",
      "type": "textarea",
      "label": "Forces",
      "placeholder": "Exemple : Forces actuelles de l'entreprise",
      "required": true
    },
    {
      "name": "faiblesses",
      "type": "textarea",
      "label": "Faiblesses",
      "placeholder": "Exemple : Faiblesses actuelles de l'entreprise",
      "required": true
    },
    {
      "name": "opportunites",
      "type": "textarea",
      "label": "Opportunités",
      "placeholder": "Exemple : Opportunités actuelles de l'entreprise",
      "required": true
    },
    {
      "name": "menaces",
      "type": "textarea",
      "label": "Menaces",
      "placeholder": "Exemple : Menaces actuelles de l'entreprise",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en diagnostic stratégique. Utilise {forces}, {faiblesses}, {opportunites} et {menaces} pour évaluer la stratégie de l'entreprise.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
