{
  "id": "outil-d-alerte-precoce",
  "title": "Outil d'alerte précoce",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Décrivez la situation actuelle",
      "placeholder": "Entrez une description détaillée",
      "required": true
    },
    {
      "name": "niveau_urgence",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Niveau d'urgence",
      "placeholder": "Sélectionnez un niveau",
      "required": true
    },
    {
      "name": "sources_info",
      "type": "text",
      "label": "Sources d'information utilisées",
      "placeholder": "Entrez les sources d'information",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique et veille. L'utilisateur a répondu : Secteur: {secteur}, Description: {description}, Niveau d'urgence: {niveau_urgence}, Sources d'information: {sources_info}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
