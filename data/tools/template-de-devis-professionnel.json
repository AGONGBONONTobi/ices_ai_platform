{
  "id": "template-de-devis-professionnel",
  "title": "Template de devis professionnel",
  "category": "TEMPLATES & MODÈLES PRÊTS À L'EMPLOI",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple : Entreprise XYZ",
      "required": true
    },
    {
      "name": "typeDeDevis",
      "type": "select",
      "options": [
        "Devis pour travaux de construction",
        "Devis pour services de consulting",
        "Devis pour vente de produits"
      ],
      "label": "Type de devis",
      "required": true
    },
    {
      "name": "descriptionDuProjet",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Exemple : Description détaillée du projet, y compris les objectifs et les deliverables",
      "required": true
    },
    {
      "name": "delaiDeRealisation",
      "type": "number",
      "label": "Délai de réalisation (en jours)",
      "placeholder": "Exemple : 30",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un consultant expert en création de devis professionnels. L'entreprise {entreprise} a besoin d'un devis pour un {typeDeDevis}. Le projet consiste en {descriptionDuProjet}. Le délai de réalisation est de {delaiDeRealisation} jours.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
