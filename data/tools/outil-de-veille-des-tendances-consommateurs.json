{
  "id": "outil-de-veille-des-tendances-consommateurs",
  "title": "Outil de veille des tendances consommateurs",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Mode",
        "Technologie",
        "Alimentation",
        "Santé",
        "Loisirs"
      ],
      "label": "Dans quel secteur opèrez-vous ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description_produit",
      "type": "textarea",
      "label": "Décrivez votre produit ou service",
      "placeholder": "Exemple : produit cosmétique pour la peau sensible",
      "required": true
    },
    {
      "name": "cible",
      "type": "text",
      "label": "Quelle est votre cible (âge, sexe, etc.)",
      "placeholder": "Exemple : femmes et hommes de 25 à 45 ans",
      "required": true
    },
    {
      "name": "concurrents",
      "type": "textarea",
      "label": "Listez vos principaux concurrents",
      "placeholder": "Exemple : L'Oréal, Nuxe, etc.",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un expert en veille économique. L'utilisateur opère dans le secteur {secteur} et propose le produit ou service suivant : {description_produit}. Sa cible est {cible}. Ses principaux concurrents sont {concurrents}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
