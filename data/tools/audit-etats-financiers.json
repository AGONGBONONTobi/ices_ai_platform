{
  "id": "audit-etats-financiers",
  "title": "Audit des états financiers (IFRS/OHADA/SYSCOHADA)",
  "category": "AUDITS & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "annee_exercice",
      "type": "number",
      "label": "Année d'exercice",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "régime_comptable",
      "type": "select",
      "options": [
        "IFRS",
        "OHADA",
        "SYSCOHADA"
      ],
      "label": "Régime comptable",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "description_probleme",
      "type": "textarea",
      "label": "Description du problème",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "impact_economique",
      "type": "number",
      "label": "Impact économique",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en audit. L'utilisateur a répondu : Entreprise: {entreprise}, Année d'exercice: {annee_exercice}, Régime comptable: {régime_comptable}, Description du problème: {description_probleme}, Impact économique: {impact_economique}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
