{
  "id": "outil-de-veille-concurrentielle-automatisee",
  "title": "Outil de veille concurrentielle automatisée",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "concurrents",
      "type": "textarea",
      "label": "Liste des principaux concurrents (nom des entreprises)",
      "placeholder": "Entrez les noms des concurrents, séparés par des virgules",
      "required": true
    },
    {
      "name": "objectifs",
      "type": "text",
      "label": "Objectifs de la veille concurrentielle",
      "placeholder": "Décrivez les objectifs de votre veille",
      "required": true
    },
    {
      "name": "periode",
      "type": "select",
      "options": [
        "Mensuel",
        "Trimestriel",
        "Semestriel"
      ],
      "label": "Période de la veille",
      "placeholder": "Sélectionnez une période",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique. L'utilisateur a répondu : Secteur: {secteur}, Concurrents: {concurrents}, Objectifs: {objectifs}, Période: {periode}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
