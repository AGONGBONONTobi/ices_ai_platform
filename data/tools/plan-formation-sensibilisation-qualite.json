      "placeholder": "Exemple: améliorer la conformité aux normes ISO 9001",
      "required": true
    },
    {
      "name": "variable2",
      "type": "select",
      "options": [
        "Employés",
        "Gestionnaires",
        "Partenaires externes"
      ],
      "label": "Public cible",
      "placeholder": "Sélectionnez le public",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Durée prévue (heures)",
      "placeholder": "Exemple: 8",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Budget alloué (€)",
      "placeholder": "Exemple: 2000",
      "required": true
    },
    {
