{
  "id": "plan-formation-sensibilisation-qualite",
  "title": "Plan de formation & sensibilisation qualité",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "variable1",
      "type": "textarea",
      "label": "Objectifs de la formation",
      "placeholder": "Exemple: améliorer la conformité aux normes ISO 9001",
      "required": true
    },
    {
      "name": "variable2",
      "type": "select",
      "options": [
        "Employés",
        "Gestionnaires",
        "Partenaires externes"
      ],
      "label": "Public cible",
      "placeholder": "Sélectionnez le public",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Durée prévue (heures)",
      "placeholder": "Exemple: 8",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Budget alloué (€)",
      "placeholder": "Exemple: 2000",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Méthodes pédagogiques préférées",
      "placeholder": "Exemple: ateliers interactifs, e-learning",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Objectifs de la formation: {variable1}, Public cible: {variable2}, Durée prévue (heures): {variable3}, Budget alloué (€): {variable4}, Méthodes pédagogiques préférées: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}