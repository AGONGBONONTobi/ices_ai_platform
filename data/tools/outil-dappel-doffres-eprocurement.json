{
  "id": "outil-dappel-doffres-eprocurement",
  "title": "Outil d'appel d'offres & e-procurement",
  "category": "SUPPLY CHAIN & ACHATS",
  "inputs": [
    {
      "name": "variable1",
      "type": "number",
      "label": "Nombre de fournisseurs actuellement utilisés",
      "placeholder": "Ex: 12",
      "required": true
    },
    {
      "name": "variable2",
      "type": "select",
      "options": [
        "Direct",
        "Indirect",
        "Services"
      ],
      "label": "Type de procurement",
      "placeholder": "Sélectionnez un type",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Décrivez le plus grand défi dans votre processus d'approvisionnement actuel",
      "placeholder": "Ex: Manque de visibilité sur les coûts",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Temps moyen (en jours) pour clôturer une commande d'achat",
      "placeholder": "Ex: 15",
      "required": true
    },
    {
      "name": "variable5",
      "type": "number",
      "label": "Montant annuel des achats (en €)",
      "placeholder": "Ex: 500000",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
