{
  "id": "strategie-communication-corporate-globale",
  "title": "Stratégie de communication corporate globale",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Quel est l'objectif principal de votre stratégie de communication corporate globale?",
      "placeholder": "Exemple: Accroître la notoriété de la marque",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Décrivez votre public cible principal.",
      "placeholder": "Exemple: Clients B2B, investisseurs, médias",
      "required": true
    },
    {
      "name": "variable3",
      "type": "select",
      "options": [
        "Réseaux sociaux",
        "Relations presse",
        "Newsletter",
        "Événements",
        "Autre"
      ],
      "label": "Quels canaux de communication privilégiez-vous?",
      "placeholder": "Sélectionnez un ou plusieurs canaux",
      "required": true
    },
    {
      "name": "variable4",
      "type": "number",
      "label": "Quel est le budget alloué (en €) pour cette stratégie?",
      "placeholder": "Exemple: 50000",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Quel est l'échéancier prévu pour la mise en œuvre?",
      "placeholder": "Exemple: 6 mois, phases mensuelles",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
