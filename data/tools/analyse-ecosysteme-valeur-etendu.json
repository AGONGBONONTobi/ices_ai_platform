{
  "id": "analyse-ecosysteme-valeur-etendu",
  "title": "Analyse de l'écosystème de valeur étendu",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "partenaires",
      "type": "textarea",
      "label": "Liste des partenaires clés",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "clients",
      "type": "select",
      "options": [
        "Consommateur final",
        "Entreprise intermédiaire",
        "Fournisseur"
      ],
      "label": "Type de clients",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Nombre de ressources humaines",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Budget annuel",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Partenaires: {partenaires}, Clients: {clients}, Ressources: {ressources}, Budget: {budget}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
