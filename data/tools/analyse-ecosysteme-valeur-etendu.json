{
  "id": "analyse-ecosysteme-valeur-etendu",
  "title": "Analyse de l'écosystème de valeur étendu",
  "category": "STRATÉGIE & MANAGEMENT",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "partenaires",
      "type": "textarea",
      "label": "Liste des partenaires clés",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "clients",
      "type": "select",
      "options": [
        "Consommateur final",
        "Entreprise intermédiaire",
        "Fournisseur"
      ],
      "label": "Type de clients",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "ressources",
      "type": "number",
      "label": "Nombre de ressources humaines",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Budget annuel",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Partenaires: {partenaires}, Clients: {clients}, Ressources: {ressources}, Budget: {budget}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}