{
  "id": "outil-de-gestion-des-formations",
  "title": "Outil de gestion des formations (LMS intégré)",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "formationNom",
      "type": "text",
      "label": "Nom de la formation",
      "placeholder": "Exemple : Formation de base en gestion de projet",
      "required": true
    },
    {
      "name": "formationType",
      "type": "select",
      "options": [
        "En ligne",
        "En présentiel",
        "Hybride"
      ],
      "label": "Type de formation",
      "placeholder": "Exemple : En ligne",
      "required": true
    },
    {
      "name": "formationObjectifs",
      "type": "textarea",
      "label": "Objectifs de la formation",
      "placeholder": "Exemple : Améliorer les compétences en gestion de projet",
      "required": true
    },
    {
      "name": "formationPublicCible",
      "type": "select",
      "options": [
        "Tout le personnel",
        "Équipe spécifique",
        "Collègue"
      ],
      "label": "Public cible de la formation",
      "placeholder": "Exemple : Tout le personnel",
      "required": true
    },
    {
      "name": "formationDurée",
      "type": "number",
      "label": "Durée de la formation",
      "placeholder": "Exemple : 5 jours",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un responsable RH. L'utilisateur a répondu : Nom de la formation : {formationNom}, Type de formation : {formationType}, Objectifs de la formation : {formationObjectifs}, Public cible de la formation : {formationPublicCible}, Durée de la formation : {formationDurée}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
