{
  "id": "rapport-de-veille-hebdomadaire-automatise",
  "title": "Rapport de veille hebdomadaire automatisé",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "concurrents",
      "type": "textarea",
      "label": "Liste des concurrents à surveiller (séparés par des virgules)",
      "placeholder": "Exemple : Google, Microsoft, Amazon",
      "required": true
    },
    {
      "name": "sources",
      "type": "text",
      "label": "Sources d'information à consulter (URLs ou noms de sites)",
      "placeholder": "Exemple : https://www.example.com, Reuters",
      "required": true
    },
    {
      "name": "periode",
      "type": "select",
      "options": [
        "Hebdomadaire",
        "Bi-hebdomadaire",
        "Mensuelle"
      ],
      "label": "Période de la veille",
      "placeholder": "Sélectionnez une période",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un spécialiste en intelligence économique. L'utilisateur a répondu : Secteur: {secteur}, Concurrents: {concurrents}, Sources: {sources}, Période: {periode}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
