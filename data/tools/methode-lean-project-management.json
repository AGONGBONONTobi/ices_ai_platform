{
  "id": "methode-lean-project-management",
  "title": "Méthode Lean Project Management",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "objectif",
      "type": "textarea",
      "label": "Définir l'objectif du projet",
      "placeholder": "Exemple : Améliorer la qualité du produit",
      "required": true
    },
    {
      "name": "équipe",
      "type": "select",
      "options": [
        "Équipe existante",
        "Nouvelle équipe"
      ],
      "label": "Choisir l'équipe responsable du projet",
      "placeholder": "Exemple : Équipe existante",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Définir le budget du projet",
      "placeholder": "Exemple : 10000",
      "required": true
    },
    {
      "name": "délai",
      "type": "number",
      "label": "Définir le délai du projet",
      "placeholder": "Exemple : 6 mois",
      "required": true
    },
    {
      "name": "risques",
      "type": "textarea",
      "label": "Identifier les risques du projet",
      "placeholder": "Exemple : Risque de retard, Risque de dépassement de budget",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Objectif: {objectif}, Équipe: {équipe}, Budget: {budget}, Délai: {délai}, Risques: {risques}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
