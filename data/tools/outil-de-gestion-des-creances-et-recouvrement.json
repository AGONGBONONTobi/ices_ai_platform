{
  "id": "outil-de-gestion-des-creances-et-recouvrement",
  "title": "Outil de gestion des créances & recouvrement",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "montantCreance",
      "type": "number",
      "label": "Montant de la créance",
      "placeholder": "Entrez le montant de la créance",
      "required": true
    },
    {
      "name": "dateEcheance",
      "type": "text",
      "label": "Date d'échéance",
      "placeholder": "JJ/MM/AAAA",
      "required": true
    },
    {
      "name": "etatDeSolvence",
      "type": "select",
      "options": [
        "Payé",
        "En attente",
        "Impayé"
      ],
      "label": "État de solvence du débiteur",
      "placeholder": "Sélectionnez l'état de solvence",
      "required": true
    },
    {
      "name": "descriptionProbleme",
      "type": "textarea",
      "label": "Description du problème de recouvrement",
      "placeholder": "Décrivez le problème de recouvrement",
      "required": true
    },
    {
      "name": "methodeDeRecouvrement",
      "type": "select",
      "options": [
        "Courrier",
        "Téléphone",
        "Courriel"
      ],
      "label": "Méthode de recouvrement préférée",
      "placeholder": "Sélectionnez la méthode de recouvrement",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des créances et recouvrement. L'utilisateur a répondu : Montant de la créance : {montantCreance}, Date d'échéance : {dateEcheance}, État de solvence du débiteur : {etatDeSolvence}, Description du problème de recouvrement : {descriptionProbleme}, Méthode de recouvrement préférée : {methodeDeRecouvrement}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
