{
  "id": "outil-de-veille-des-prix-et-indices-sectoriels",
  "title": "Outil de veille des prix & indices sectoriels",
  "category": "INTELLIGENCE ÉCONOMIQUE & VEILLE",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Finance",
        "Santé",
        "Énergie",
        "Autres"
      ],
      "label": "Sélectionnez le secteur d'activité",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Décrivez les produits ou services que vous souhaitez suivre",
      "placeholder": "Exemple : produits électroniques, services financiers, etc.",
      "required": true
    },
    {
      "name": "periode",
      "type": "select",
      "options": [
        "Mensuel",
        "Trimestriel",
        "Semestriel",
        "Annuel"
      ],
      "label": "Sélectionnez la période de suivi",
      "placeholder": "",
      "required": true
    },
    {
      "name": "concurrents",
      "type": "text",
      "label": "Liste des concurrents à surveiller (séparés par des virgules)",
      "placeholder": "Exemple : Entreprise A, Entreprise B, etc.",
      "required": false
    }
  ],
  "promptTemplate": "Vous êtes un expert en intelligence économique. L'utilisateur a répondu : Secteur: {secteur}, Description: {description}, Période: {periode}, Concurrents: {concurrents}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
