{
  "id": "tableau-de-financement-et-plan-de-financement",
  "title": "Tableau de financement & plan de financement",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "montant-investi",
      "type": "number",
      "label": "Montant investi",
      "placeholder": "Entrez le montant investi",
      "required": true
    },
    {
      "name": "taux-de-retour",
      "type": "number",
      "label": "Taux de retour",
      "placeholder": "Entrez le taux de retour",
      "required": true
    },
    {
      "name": "periode-dinvestissement",
      "type": "select",
      "options": [
        "Moins de 6 mois",
        "6-12 mois",
        "Plus de 1 an"
      ],
      "label": "Période d'investissement",
      "placeholder": "Sélectionnez la période d'investissement",
      "required": true
    },
    {
      "name": "objectifs-financiers",
      "type": "textarea",
      "label": "Objectifs financiers",
      "placeholder": "Décrivez vos objectifs financiers",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en finance. L'utilisateur a répondu : Montant investi: {montant-investi}, Taux de retour: {taux-de-retour}, Période d'investissement: {periode-dinvestissement}, Objectifs financiers: {objectifs-financiers}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}