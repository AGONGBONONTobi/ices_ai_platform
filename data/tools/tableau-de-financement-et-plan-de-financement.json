  "promptTemplate": "Tu es un expert en finance. L'utilisateur a répondu : Montant investi: {montant-investi}, Taux de retour: {taux-de-retour}, Période d'investissement: {periode-dinvestissement}, Objectifs financiers: {objectifs-financiers}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
