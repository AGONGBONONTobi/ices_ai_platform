{
  "id": "plan-de-sourcing-international-multi-sourcing",
  "title": "Plan de sourcing international & multi-sourcing",
  "category": "SUPPLY CHAIN & ACHATS",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Single sourcing",
        "Multi-sourcing",
        "Hybrid"
      ],
      "label": "Quel type de sourcing envisagez-vous?",
      "placeholder": "Sélectionnez un type",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Décrivez brièvement votre projet de sourcing",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Quel est le budget alloué à ce projet?",
      "placeholder": "100000",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Listez les principaux fournisseurs que vous ciblez",
      "placeholder": "Exemple: Fournisseur A, Fournisseur B",
      "required": false
    },
    {
      "name": "variable5",
      "type": "select",
      "options": [
        "Europe",
        "Asie",
        "Amérique du Nord",
        "Amérique du Sud",
        "Afrique"
      ],
      "label": "Quelle zone géographique ciblez-vous?",
      "placeholder": "Sélectionnez une zone",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}