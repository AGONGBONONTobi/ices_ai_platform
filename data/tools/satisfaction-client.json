{
  "id": "satisfaction-client",
  "title": "Mesure de la satisfaction & expérience client",
  "category": "MARKETING & COMMERCIAL",
  "inputs": [
    {
      "name": "note-satisfaction",
      "type": "number",
      "label": "Note de satisfaction sur 10",
      "placeholder": "Exemple de note",
      "required": true
    },
    {
      "name": "commentaire-client",
      "type": "textarea",
      "label": "Commentaire du client",
      "placeholder": "Exemple de commentaire",
      "required": false
    },
    {
      "name": "type-transaction",
      "type": "select",
      "options": [
        "Achat",
        "Service",
        "Autre"
      ],
      "label": "Type de transaction",
      "placeholder": "Exemple de type de transaction",
      "required": true
    },
    {
      "name": "duree-transaction",
      "type": "number",
      "label": "Durée de la transaction (en minutes)",
      "placeholder": "Exemple de durée",
      "required": true
    },
    {
      "name": "forme-contact",
      "type": "select",
      "options": [
        "Réseau social",
        "Courriel",
        "Téléphone"
      ],
      "label": "Forme de contact",
      "placeholder": "Exemple de forme de contact",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Note de satisfaction : {note-satisfaction}, Commentaire du client : {commentaire-client}, Type de transaction : {type-transaction}, Durée de la transaction : {duree-transaction}, Forme de contact : {forme-contact}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
