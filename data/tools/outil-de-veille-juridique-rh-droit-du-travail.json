{
  "id": "outil-de-veille-juridique-rh-droit-du-travail",
  "title": "Outil de veille juridique RH & droit du travail",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple : XYZ SA",
      "required": true
    },
    {
      "name": "domaine",
      "type": "select",
      "options": [
        "Droit du travail",
        "Droit social",
        "Droit de la consommation"
      ],
      "label": "Domaine d'intervention",
      "placeholder": "Sélectionnez un domaine",
      "required": true
    },
    {
      "name": "description_evenement",
      "type": "textarea",
      "label": "Description de l'événement",
      "placeholder": "Exemple : Modification du code du travail",
      "required": true
    },
    {
      "name": "impact",
      "type": "number",
      "label": "Impact de l'événement sur l'entreprise",
      "placeholder": "Exemple : 5/10",
      "required": true
    },
    {
      "name": "recommandations",
      "type": "textarea",
      "label": "Recommandations pour l'entreprise",
      "placeholder": "Exemple : Mettre à jour les procédures internes",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en droit du travail. L'utilisateur a répondu : Entreprise : {entreprise}, Domaine : {domaine}, Description de l'événement : {description_evenement}, Impact : {impact}, Recommandations : {recommandations}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
