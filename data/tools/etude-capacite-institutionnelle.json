{
  "id": "etude-capacite-institutionnelle",
  "title": "Étude de capacité institutionnelle",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Nom de l'institution",
      "placeholder": "Exemple: Université de Paris",
      "required": true
    },
    {
      "name": "variable2",
      "type": "number",
      "label": "Nombre d'employés",
      "placeholder": "Exemple: 250",
      "required": true
    },
    {
      "name": "variable3",
      "type": "textarea",
      "label": "Domaines de compétence clés",
      "placeholder": "Exemple: Recherche, Enseignement, Innovation",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Niveau de maturité en gestion de projet",
      "placeholder": "Sélectionnez",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Principaux défis rencontrés",
      "placeholder": "Exemple: Manque de financement, Manque de formation",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}