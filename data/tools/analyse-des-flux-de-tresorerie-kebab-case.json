{
  "id": "analyse-des-flux-de-tresorerie-kebab-case",
  "title": "Analyse des flux de trésorerie (Cash flow statement)",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "revenus-opérationnels",
      "type": "number",
      "label": "Revenus opérationnels (en millions de €)",
      "placeholder": "Exemple : 100",
      "required": true
    },
    {
      "name": "revenus-financiers",
      "type": "number",
      "label": "Revenus financiers (en millions de €)",
      "placeholder": "Exemple : 20",
      "required": true
    },
    {
      "name": "dépenses-opérationnelles",
      "type": "number",
      "label": "Dépenses opérationnelles (en millions de €)",
      "placeholder": "Exemple : 80",
      "required": true
    },
    {
      "name": "dépenses-financières",
      "type": "number",
      "label": "Dépenses financières (en millions de €)",
      "placeholder": "Exemple : 10",
      "required": true
    },
    {
      "name": "type-d'entreprise",
      "type": "select",
      "options": [
        "Entreprise individuelle",
        "Société à responsabilité limitée",
        "Société anonyme"
      ],
      "label": "Type d'entreprise",
      "placeholder": "Exemple : Entreprise individuelle",
      "required": true
    }
  ],
  "promptTemplate": "Analyse des flux de trésorerie d'une entreprise de type {type-d'entreprise}. Les revenus opérationnels sont de {revenus-opérationnels} millions de €, tandis que les revenus financiers sont de {revenus-financiers} millions de €. Les dépenses opérationnelles sont de {dépenses-opérationnelles} millions de €, et les dépenses financières sont de {dépenses-financières} millions de €. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}