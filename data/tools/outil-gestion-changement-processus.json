{
  "id": "outil-gestion-changement-processus",
  "title": "Outil de gestion du changement processus",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Initial",
        "Managed",
        "Defined",
        "Quantitatively Managed",
        "Optimizing"
      ],
      "label": "Niveau de maturité actuel",
      "placeholder": "Sélectionnez un niveau",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Obstacles rencontrés",
      "placeholder": "Exemple: résistance des employés, manque de ressources",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Nombre de projets",
      "placeholder": "Entrez un nombre",
      "required": true
    },
    {
      "name": "variable4",
      "type": "text",
      "label": "Objectif principal",
      "placeholder": "Exemple: améliorer la satisfaction client",
      "required": true
    },
    {
      "name": "variable5",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Support de la direction",
      "placeholder": "Sélectionnez",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}