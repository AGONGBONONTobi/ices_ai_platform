{
  "id": "outil-gestion-medicaments-essentiels",
  "title": "Outil de gestion des médicaments essentiels",
  "category": "OUTILS SECTORIELS SPÉCIALISÉS",
  "inputs": [
    {
      "name": "pathologie",
      "type": "select",
      "options": [
        "Diabète",
        "Hhypertension",
        "Asthme",
        "Maladie cardiaque"
      ],
      "label": "Quelle est la pathologie principale du patient ?",
      "placeholder": "Sélectionnez une pathologie",
      "required": true
    },
    {
      "name": "medicamentsActuels",
      "type": "textarea",
      "label": "Quels sont les médicaments actuellement pris par le patient ?",
      "placeholder": "Liste des médicaments",
      "required": true
    },
    {
      "name": "allergies",
      "type": "text",
      "label": "Le patient a-t-il des allergies ?",
      "placeholder": "Description des allergies",
      "required": false
    },
    {
      "name": "agePatient",
      "type": "number",
      "label": "Quel est l'âge du patient ?",
      "placeholder": "Âge du patient",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un pharmacologue. Le patient a {agePatient} ans, il est atteint de {pathologie}, il prend actuellement les médicaments suivants : {medicamentsActuels} et a des allergies : {allergies}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
