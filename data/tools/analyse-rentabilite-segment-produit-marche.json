{
  "id": "analyse-rentabilite-segment-produit-marche",
  "title": "Analyse de rentabilité par segment/produit/marché",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "segment",
      "type": "select",
      "options": [
        "Segment A",
        "Segment B",
        "Segment C"
      ],
      "label": "Sélectionner le segment d'analyse",
      "placeholder": "",
      "required": true
    },
    {
      "name": "produit",
      "type": "select",
      "options": [
        "Produit 1",
        "Produit 2",
        "Produit 3"
      ],
      "label": "Sélectionner le produit d'analyse",
      "placeholder": "",
      "required": true
    },
    {
      "name": "marche",
      "type": "select",
      "options": [
        "Marché 1",
        "Marché 2",
        "Marché 3"
      ],
      "label": "Sélectionner le marché d'analyse",
      "placeholder": "",
      "required": true
    },
    {
      "name": "revenus",
      "type": "number",
      "label": "Entrer les revenus totaux du segment/produit/marché",
      "placeholder": "0",
      "required": true
    },
    {
      "name": "couts",
      "type": "number",
      "label": "Entrer les coûts totaux du segment/produit/marché",
      "placeholder": "0",
      "required": true
    },
    {
      "name": "textarea",
      "type": "textarea",
      "label": "Ajouter des commentaires supplémentaires",
      "placeholder": "",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un expert en finance. L'utilisateur a sélectionné le segment {segment}, le produit {produit} et le marché {marche}. Les revenus totaux sont de {revenus} et les coûts totaux sont de {couts}.",
