{
  "id": "outil-de-simulation-financiere-de-projet-ppp",
  "title": "Outil de simulation financière de projet PPP",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "type_de_projet",
      "type": "select",
      "options": [
        "Infrastructure routière",
        "Infrastructure énergétique",
        "Infrastructure de santé"
      ],
      "label": "Type de projet PPP",
      "placeholder": "Sélectionnez le type de projet",
      "required": true
    },
    {
      "name": "cout_initial",
      "type": "number",
      "label": "Coût initial du projet",
      "placeholder": "1000000",
      "required": true
    },
    {
      "name": "description_projet",
      "type": "textarea",
      "label": "Description détaillée du projet",
      "placeholder": "Veuillez décrire le projet",
      "required": true
    },
    {
      "name": "duree_projet",
      "type": "number",
      "label": "Durée du projet en mois",
      "placeholder": "24",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en simulation financière de projets PPP. L'utilisateur a répondu : Type de projet : {type_de_projet}, Coût initial : {cout_initial}, Description du projet : {description_projet}, Durée du projet : {duree_projet} mois.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
