{
  "id": "entretien-professionnel-gepp-numerique",
  "title": "Entretien professionnel GEPP numérique",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "candidat",
      "type": "text",
      "label": "Nom et prénom du candidat",
      "placeholder": "Exemple : Jean Dupont",
      "required": true
    },
    {
      "name": "poste",
      "type": "select",
      "options": [
        "Développeur",
        "Conseiller RH",
        "Chef d'équipe"
      ],
      "label": "Poste pour lequel le candidat est candidat",
      "placeholder": "Exemple : Développeur",
      "required": true
    },
    {
      "name": "experience",
      "type": "textarea",
      "label": "Expérience professionnelle du candidat (en mots)",
      "placeholder": "Exemple : 5 ans d'expérience en développement web",
      "required": true
    },
    {
      "name": "competences",
      "type": "select",
      "options": [
        "Langages de programmation",
        "Bases de données",
        "Systèmes d'exploitation"
      ],
      "label": "Compétences techniques du candidat",
      "placeholder": "Exemple : Langages de programmation",
      "required": true
    },
    {
      "name": "motivation",
      "type": "textarea",
      "label": "Motivation du candidat pour ce poste",
      "placeholder": "Exemple : Je suis motivé pour ce poste car je souhaite développer mes compétences en développement web",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Candidat : {candidat}, Poste : {poste}, Expérience : {experience}, Compétences : {competences}, Motivation : {motivation}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
