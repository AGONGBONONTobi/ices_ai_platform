{
  "id": "rapport-davancement-automatise-kebab-case",
  "title": "Rapport d'avancement automatisé (RAG status)",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "projet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple de projet",
      "required": true
    },
    {
      "name": "avancement",
      "type": "number",
      "label": "Avancement actuel (%)",
      "placeholder": "Exemple de pourcentage",
      "required": true
    },
    {
      "name": "risques",
      "type": "textarea",
      "label": "Liste des risques identifiés",
      "placeholder": "Exemple de risque",
      "required": true
    },
    {
      "name": "actions",
      "type": "textarea",
      "label": "Liste des actions à réaliser",
      "placeholder": "Exemple d'action",
      "required": true
    },
    {
      "name": "priorite",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Élevé"
      ],
      "label": "Priorité du projet",
      "placeholder": "Exemple de priorité",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion de projet. L'utilisateur a répondu : Projet: {projet}, Avancement: {avancement}%, Risques: {risques}, Actions: {actions}, Priorité: {priorite}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}