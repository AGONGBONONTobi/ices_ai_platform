{
  "id": "programme-qvt-qvct-structure",
  "title": "Programme QVT/QVCT structuré",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "postes_affectes",
      "type": "number",
      "label": "Nombre de postes affectés",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "type_de_contrat",
      "type": "select",
      "options": [
        "CDI",
        "CDD",
        "INTÉRIM"
      ],
      "label": "Type de contrat",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "duree_de_contrat",
      "type": "number",
      "label": "Durée de contrat en mois",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "description_de_l_intervention",
      "type": "textarea",
      "label": "Description de l'intervention",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Entreprise: {entreprise}, Nombre de postes affectés: {postes_affectes}, Type de contrat: {type_de_contrat}, Durée de contrat en mois: {duree_de_contrat}, Description de l'intervention: {description_de_l_intervention}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}