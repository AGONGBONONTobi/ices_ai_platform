{
  "id": "gestion-zones-franches-entrepots-sous-douane",
  "title": "Outil de gestion des zones franches & entrepôts sous douane",
  "category": "SUPPLY CHAIN & ACHATS",
  "inputs": [
    {
      "name": "zone_type",
      "type": "select",
      "options": [
        "Zone franche",
        "Entrepôt sous douane",
        "Zone de transit"
      ],
      "label": "Type de zone",
      "placeholder": "Sélectionnez le type de zone",
      "required": true
    },
    {
      "name": "number_of_warehouses",
      "type": "number",
      "label": "Nombre d'entrepôts",
      "placeholder": "Entrez le nombre d'entrepôts",
      "required": true
    },
    {
      "name": "customs_regulations",
      "type": "textarea",
      "label": "Réglementations douanières applicables",
      "placeholder": "Décrivez les réglementations douanières",
      "required": false
    },
    {
      "name": "budget_annual",
      "type": "number",
      "label": "Budget annuel alloué (en €)",
      "placeholder": "Entrez le budget annuel",
      "required": true
    },
    {
      "name": "expected_volume",
      "type": "textarea",
      "label": "Volume de marchandises attendu",
      "placeholder": "Décrivez le volume attendu",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Zone type: {zone_type}, Nombre d'entrepôts: {number_of_warehouses}, Réglementations douanières: {customs_regulations}, Budget annuel: {budget_annual}, Volume attendu: {expected_volume}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
