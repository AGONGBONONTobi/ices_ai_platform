{
  "id": "analyse-post-mortem-lecons-apprises",
  "title": "Analyse post-mortem & leçons apprises",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "projet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet XYZ",
      "required": true
    },
    {
      "name": "objectif",
      "type": "textarea",
      "label": "Objectif du projet",
      "placeholder": "Exemple : Améliorer la productivité",
      "required": true
    },
    {
      "name": "resultat",
      "type": "number",
      "label": "Résultat atteint (en %)",
      "placeholder": "Exemple : 85%",
      "required": true
    },
    {
      "name": "cause",
      "type": "select",
      "options": [
        "Manque de ressources",
        "Problèmes de communication",
        "Défaut de planification"
      ],
      "label": "Cause principale du projet",
      "placeholder": "Choisissez une option",
      "required": true
    },
    {
      "name": "recommandation",
      "type": "textarea",
      "label": "Recommandation pour améliorer le projet",
      "placeholder": "Exemple : Mettre en place un plan de communication clair",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Projet : {projet}, Objectif : {objectif}, Résultat atteint : {resultat}%, Cause principale : {cause}, Recommandation : {recommandation}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}