{
  "id": "analyse-post-mortem-lecons-apprises",
  "title": "Analyse post-mortem & leçons apprises",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "projet",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet XYZ",
      "required": true
    },
    {
      "name": "objectif",
      "type": "textarea",
      "label": "Objectif du projet",
      "placeholder": "Exemple : Améliorer la productivité",
      "required": true
    },
    {
      "name": "resultat",
      "type": "number",
      "label": "Résultat atteint (en %)",
      "placeholder": "Exemple : 85%",
      "required": true
    },
    {
      "name": "cause",
      "type": "select",
      "options": [
        "Manque de ressources",
        "Problèmes de communication",
        "Défaut de planification"
      ],
      "label": "Cause principale du projet",
      "placeholder": "Choisissez une option",
      "required": true
    },
    {
      "name": "recommandation",
      "type": "textarea",
      "label": "Recommandation pour améliorer le projet",
      "placeholder": "Exemple : Mettre en place un plan de communication clair",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Projet : {projet}, Objectif : {objectif}, Résultat atteint : {resultat}%, Cause principale : {cause}, Recommandation : {recommandation}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
