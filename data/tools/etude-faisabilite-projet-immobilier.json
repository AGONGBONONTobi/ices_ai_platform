{
  "id": "etude-faisabilite-projet-immobilier",
  "title": "Étude de faisabilité d'un projet immobilier",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "variable1",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Ex: Tour Eiffel 2.0",
      "required": true
    },
    {
      "name": "variable2",
      "type": "number",
      "label": "Budget estimé (en €)",
      "placeholder": "Ex: 5000000",
      "required": true
    },
    {
      "name": "variable3",
      "type": "select",
      "options": [
        "Résidentiel",
        "Commercial",
        "Mixte",
        "Industriel"
      ],
      "label": "Type de projet",
      "required": true
    },
    {
      "name": "variable4",
      "type": "textarea",
      "label": "Description détaillée du projet",
      "placeholder": "Ex: Construction d'un immeuble de bureaux...",
      "required": true
    },
    {
      "name": "variable5",
      "type": "text",
      "label": "Date de début prévue (YYYY-MM-DD)",
      "placeholder": "Ex: 2025-06-01",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}