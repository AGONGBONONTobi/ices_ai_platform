{
  "id": "outil-de-gestion-des-idees",
  "title": "Outil de gestion des idées (Ideation management)",
  "category": "INNOVATION & R&D",
  "inputs": [
    {
      "name": "idee",
      "type": "textarea",
      "label": "Décrivez votre idée",
      "placeholder": "Exemple : Création d'un nouveau produit pour améliorer l'efficacité énergétique",
      "required": true
    },
    {
      "name": "domaine",
      "type": "select",
      "options": [
        "Technologie",
        "Santé",
        "Environnement",
        "Éducation"
      ],
      "label": "Domaine d'application de l'idée",
      "required": true
    },
    {
      "name": "objectif",
      "type": "text",
      "label": "Quel est l'objectif principal de votre idée ?",
      "placeholder": "Exemple : Réduire les coûts, améliorer la qualité de vie",
      "required": true
    },
    {
      "name": "public_cible",
      "type": "select",
      "options": [
        "Grand public",
        "Entreprises",
        "Institutions",
        "Gouvernements"
      ],
      "label": "Public cible pour votre idée",
      "required": true
    }
  ],
  "promptTemplate": "Vous êtes un expert en innovation. L'utilisateur a répondu : Idée: {idee}, Domaine: {domaine}, Objectif: {objectif}, Public cible: {public_cible}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
