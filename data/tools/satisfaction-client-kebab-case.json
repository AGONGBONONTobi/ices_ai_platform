{
  "id": "satisfaction-client-kebab-case",
  "title": "Mesure de la satisfaction & expérience client",
  "category": "MARKETING & COMMERCIAL",
  "inputs": [
    {
      "name": "note-satisfaction",
      "type": "number",
      "label": "Note de satisfaction sur 10",
      "placeholder": "Exemple de note",
      "required": true
    },
    {
      "name": "commentaire-client",
      "type": "textarea",
      "label": "Commentaire du client",
      "placeholder": "Exemple de commentaire",
      "required": false
    },
    {
      "name": "type-transaction",
      "type": "select",
      "options": [
        "Achat",
        "Service",
        "Autre"
      ],
      "label": "Type de transaction",
      "placeholder": "Exemple de type de transaction",
      "required": true
    },
    {
      "name": "duree-transaction",
      "type": "number",
      "label": "Durée de la transaction (en minutes)",
      "placeholder": "Exemple de durée",
      "required": true
    },
    {
      "name": "forme-contact",
      "type": "select",
      "options": [
        "Réseau social",
        "Courriel",
        "Téléphone"
      ],
      "label": "Forme de contact",
      "placeholder": "Exemple de forme de contact",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Note de satisfaction : {note-satisfaction}, Commentaire du client : {commentaire-client}, Type de transaction : {type-transaction}, Durée de la transaction : {duree-transaction}, Forme de contact : {forme-contact}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}