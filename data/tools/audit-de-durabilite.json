{
  "id": "audit-de-durabilite",
  "title": "Audit de durabilité (CSRD/DPEF/reporting extra-financier)",
  "category": "AUDITS & CONFORMITÉ",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "objectif-strategique",
      "type": "textarea",
      "label": "Objectif stratégique de l'entreprise",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "impact-environnemental",
      "type": "number",
      "label": "Impact environnemental de l'entreprise (sur 100)",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "impact-social",
      "type": "number",
      "label": "Impact social de l'entreprise (sur 100)",
      "placeholder": "Exemple de réponse",
      "required": true
    },
    {
      "name": "type-de-reporting",
      "type": "select",
      "options": [
        "CSRD",
        "DPEF",
        "Reporting extra-financier"
      ],
      "label": "Type de reporting extra-financier",
      "placeholder": "Exemple de réponse",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en durabilité. L'utilisateur a répondu : Entreprise: {entreprise}, Objectif stratégique: {objectif-strategique}, Impact environnemental: {impact-environnemental}, Impact social: {impact-social}, Type de reporting: {type-de-reporting}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          },
          "required": [
            "axe",
            "score"
          ]
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "score_global",
      "axes",
      "recommandations"
    ]
  },
  "output_kind": "assessment"
}
