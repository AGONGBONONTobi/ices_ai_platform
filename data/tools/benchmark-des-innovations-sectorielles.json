{
  "id": "benchmark-des-innovations-sectorielles",
  "title": "Benchmark des innovations sectorielles",
  "category": "INNOVATION & R&D",
  "inputs": [
    {
      "name": "secteur",
      "type": "select",
      "options": [
        "Technologie",
        "Énergie",
        "Santé",
        "Autres"
      ],
      "label": "Quel secteur d'activité est concerné par l'innovation ?",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "description",
      "type": "textarea",
      "label": "Décrivez brièvement l'innovation",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "impact",
      "type": "number",
      "label": "Quel est l'impact environnemental de l'innovation (échelle de 1 à 10) ?",
      "placeholder": "Exemple d'impact",
      "required": true
    },
    {
      "name": "budget",
      "type": "number",
      "label": "Quel est le budget alloué à l'innovation ?",
      "placeholder": "Exemple de budget",
      "required": true
    },
    {
      "name": "resultats",
      "type": "textarea",
      "label": "Quels sont les résultats attendus de l'innovation ?",
      "placeholder": "Exemple de résultats",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en innovation et R&D. L'utilisateur a répondu : Secteur: {secteur}, Description: {description}, Impact environnemental: {impact}, Budget: {budget}, Résultats attendus: {resultats}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
