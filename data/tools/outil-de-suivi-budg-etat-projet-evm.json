{
  "id": "outil-de-suivi-budg-etat-projet-evm",
  "title": "Outil de suivi budgétaire projet (EVM)",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "budget_initial",
      "type": "number",
      "label": "Budget initial du projet",
      "placeholder": "Entrez le budget initial",
      "required": true
    },
    {
      "name": "budget_actuel",
      "type": "number",
      "label": "Budget actuel du projet",
      "placeholder": "Entrez le budget actuel",
      "required": true
    },
    {
      "name": "duree_projet",
      "type": "number",
      "label": "Durée prévue du projet",
      "placeholder": "Entrez la durée prévue en jours",
      "required": true
    },
    {
      "name": "duree_reelle",
      "type": "number",
      "label": "Durée réelle du projet",
      "placeholder": "Entrez la durée réelle en jours",
      "required": true
    },
    {
      "name": "type_projet",
      "type": "select",
      "options": [
        "Développement",
        "Maintenance",
        "Réalisations"
      ],
      "label": "Type de projet",
      "placeholder": "Sélectionnez le type de projet",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion de projet. L'utilisateur a répondu : Budget initial : {budget_initial}, Budget actuel : {budget_actuel}, Durée prévue : {duree_projet}, Durée réelle : {duree_reelle}, Type de projet : {type_projet}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
