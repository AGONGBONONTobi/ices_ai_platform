{
  "id": "outil-revue-direction-management-review",
  "title": "Outil de revue de direction & management review",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "review_name",
      "type": "text",
      "label": "Nom de la revue",
      "placeholder": "Ex: Revue de direction Q3 2024",
      "required": true
    },
    {
      "name": "frequency",
      "type": "select",
      "options": [
        "Mensuelle",
        "Trimestrielle",
        "Annuelle"
      ],
      "label": "Fréquence de la revue",
      "placeholder": "",
      "required": true
    },
    {
      "name": "performance_scale",
      "type": "number",
      "label": "Échelle de performance (1-10)",
      "placeholder": "Ex: 8",
      "required": true
    },
    {
      "name": "observations",
      "type": "textarea",
      "label": "Observations générales",
      "placeholder": "Ex: Les objectifs ont été atteints...",
      "required": false
    },
    {
      "name": "review_date",
      "type": "text",
      "label": "Date de la revue",
      "placeholder": "Ex: 15/09/2024",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert en qualité et excellence opérationnelle. L'utilisateur a répondu : Review Name: {review_name}, Frequency: {frequency}, Performance Scale: {performance_scale}, Observations: {observations}, Review Date: {review_date}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
