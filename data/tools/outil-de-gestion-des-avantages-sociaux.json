{
  "id": "outil-de-gestion-des-avantages-sociaux",
  "title": "Outil de gestion des avantages sociaux",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple : Société Générale",
      "required": true
    },
    {
      "name": "type-d-avantage",
      "type": "select",
      "options": [
        "Congés payés",
        "Indemnités chômage",
        "Allocations familiales"
      ],
      "label": "Type d'avantage social",
      "placeholder": "Exemple : Congés payés",
      "required": true
    },
    {
      "name": "montant-d-avantage",
      "type": "number",
      "label": "Montant de l'avantage",
      "placeholder": "Exemple : 1000",
      "required": true
    },
    {
      "name": "periode-d-avantage",
      "type": "textarea",
      "label": "Période de l'avantage",
      "placeholder": "Exemple : Du 01/01/2022 au 31/12/2022",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des avantages sociaux. L'utilisateur a répondu : Entreprise : {entreprise}, Type d'avantage : {type-d-avantage}, Montant de l'avantage : {montant-d-avantage}, Période de l'avantage : {periode-d-avantage}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}