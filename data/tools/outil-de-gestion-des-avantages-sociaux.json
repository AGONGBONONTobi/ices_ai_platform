{
  "id": "outil-de-gestion-des-avantages-sociaux",
  "title": "Outil de gestion des avantages sociaux",
  "category": "RH & CAPITAL HUMAIN",
  "inputs": [
    {
      "name": "entreprise",
      "type": "text",
      "label": "Nom de l'entreprise",
      "placeholder": "Exemple : Société Générale",
      "required": true
    },
    {
      "name": "type-d-avantage",
      "type": "select",
      "options": [
        "Congés payés",
        "Indemnités chômage",
        "Allocations familiales"
      ],
      "label": "Type d'avantage social",
      "placeholder": "Exemple : Congés payés",
      "required": true
    },
    {
      "name": "montant-d-avantage",
      "type": "number",
      "label": "Montant de l'avantage",
      "placeholder": "Exemple : 1000",
      "required": true
    },
    {
      "name": "periode-d-avantage",
      "type": "textarea",
      "label": "Période de l'avantage",
      "placeholder": "Exemple : Du 01/01/2022 au 31/12/2022",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des avantages sociaux. L'utilisateur a répondu : Entreprise : {entreprise}, Type d'avantage : {type-d-avantage}, Montant de l'avantage : {montant-d-avantage}, Période de l'avantage : {periode-d-avantage}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
