{
  "id": "plan-communication-evenementiel",
  "title": "Plan de communication événementiel",
  "category": "COMMUNICATION & RELATIONS EXTÉRIEURES",
  "inputs": [
    {
      "name": "variable1",
      "type": "select",
      "options": [
        "Public cible",
        "Partenaires",
        "Médias"
      ],
      "label": "Quel est le public cible principal de l'événement?",
      "placeholder": "Ex: Clients B2B, investisseurs",
      "required": true
    },
    {
      "name": "variable2",
      "type": "textarea",
      "label": "Décrivez brièvement l'événement (type, date, lieu)",
      "placeholder": "Ex: Conférence annuelle, 15 juin 2025, Paris",
      "required": true
    },
    {
      "name": "variable3",
      "type": "number",
      "label": "Budget alloué (en €)",
      "placeholder": "Ex: 50000",
      "required": true
    },
    {
      "name": "variable4",
      "type": "select",
      "options": [
        "Oui",
        "Non"
      ],
      "label": "Avez-vous déjà un plan de communication existant?",
      "placeholder": "Ex: Oui",
      "required": true
    },
    {
      "name": "variable5",
      "type": "textarea",
      "label": "Quels canaux de communication envisagez-vous d'utiliser?",
      "placeholder": "Ex: Email, réseaux sociaux, presse",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Variable1: {variable1}, Variable2: {variable2}, Variable3: {variable3}, Variable4: {variable4}, Variable5: {variable5}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "titre": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      }
    },
    "required": [
      "titre",
      "sections"
    ]
  },
  "output_kind": "document"
}
