{
  "id": "outil-escalade-gestion-issues-projet",
  "title": "Outil d'escalade & gestion des issues projet",
  "category": "GESTION DE PROJETS & PMO",
  "inputs": [
    {
      "name": "priorite",
      "type": "select",
      "options": [
        "Faible",
        "Moyen",
        "Elevé"
      ],
      "label": "Quelle est la priorité de l'issue ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description-issue",
      "type": "textarea",
      "label": "Décrivez brièvement l'issue",
      "placeholder": "Exemple de description",
      "required": true
    },
    {
      "name": "responsable",
      "type": "text",
      "label": "Qui est responsable de l'issue ?",
      "placeholder": "Exemple de responsable",
      "required": true
    },
    {
      "name": "deadline",
      "type": "number",
      "label": "Quel est le délai pour résoudre l'issue ?",
      "placeholder": "Exemple de délai",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Priorité: {priorite}, Description de l'issue: {description-issue}, Responsable: {responsable}, Délai: {deadline}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
