{
  "id": "analytics-pedagogiques-kebab-case",
  "title": "Analytics pédagogiques (EdTech/LMS)",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "type-d-activite",
      "type": "select",
      "options": [
        "Cours en ligne",
        "Atelier en ligne",
        "Quiz en ligne",
        "Exercice en ligne"
      ],
      "label": "Type d'activité",
      "placeholder": "Sélectionnez le type d'activité",
      "required": true
    },
    {
      "name": "taux-de-reussite",
      "type": "number",
      "label": "Taux de réussite",
      "placeholder": "Entrez le taux de réussite",
      "required": true
    },
    {
      "name": "temps-de-realisation",
      "type": "textarea",
      "label": "Temps de réalisation",
      "placeholder": "Décrivez le temps de réalisation",
      "required": true
    },
    {
      "name": "commentaires-enseignant",
      "type": "textarea",
      "label": "Commentaires de l'enseignant",
      "placeholder": "Décrivez les commentaires de l'enseignant",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en analytics pédagogiques. L'utilisateur a répondu : Type d'activité: {type-d-activite}, Taux de réussite: {taux-de-reussite}%, Temps de réalisation: {temps-de-realisation}, Commentaires de l'enseignant: {commentaires-enseignant}. Analyse ces informations et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}