{
  "id": "spc-performance-measurement-tool",
  "title": "Outil de mesure de la performance des processus (SPC)",
  "category": "QUALITÉ & EXCELLENCE OPÉRATIONNELLE",
  "inputs": [
    {
      "name": "sample_size",
      "type": "number",
      "label": "Taille de l'échantillon",
      "placeholder": "Ex. 500",
      "required": true
    },
    {
      "name": "process_type",
      "type": "select",
      "options": [
        "Manufacturing",
        "Service",
        "Logistics",
        "Software Development"
      ],
      "label": "Type de processus",
      "placeholder": "Sélectionnez un type",
      "required": true
    },
    {
      "name": "defect_rate",
      "type": "number",
      "label": "Taux de défauts (%)",
      "placeholder": "Ex. 2.5",
      "required": true
    },
    {
      "name": "cycle_time",
      "type": "number",
      "label": "Temps de cycle (minutes)",
      "placeholder": "Ex. 15",
      "required": true
    },
    {
      "name": "comments",
      "type": "textarea",
      "label": "Commentaires supplémentaires",
      "placeholder": "Entrez vos observations",
      "required": false
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Sample Size: {sample_size}, Process Type: {process_type}, Defect Rate: {defect_rate}%, Cycle Time: {cycle_time} minutes, Comments: {comments}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
