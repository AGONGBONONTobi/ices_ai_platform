  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "annee",
      "type": "number",
      "label": "Année de référence",
      "placeholder": "Saisissez l'année",
      "required": true
    },
    {
      "name": "type-sinistre",
      "type": "select",
      "options": [
        "Incendie",
        "Inondation",
        "Vol",
        "Autre"
      ],
      "label": "Type de sinistre",
      "placeholder": "Sélectionnez le type de sinistre",
      "required": true
    },
    {
      "name": "montant-sinistre",
      "type": "number",
      "label": "Montant du sinistre",
      "placeholder": "Saisissez le montant du sinistre",
