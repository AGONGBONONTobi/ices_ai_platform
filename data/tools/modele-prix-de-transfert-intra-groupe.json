{
  "id": "modele-prix-de-transfert-intra-groupe",
  "title": "Modèle de prix de transfert intra-groupe",
  "category": "FINANCE & GESTION",
  "inputs": [
    {
      "name": "societe",
      "type": "text",
      "label": "Nom de la société",
      "placeholder": "Exemple de société",
      "required": true
    },
    {
      "name": "activite",
      "type": "select",
      "options": [
        "Production",
        "Distribution",
        "Service"
      ],
      "label": "Type d'activité",
      "placeholder": "Exemple d'activité",
      "required": true
    },
    {
      "name": "cout-variable",
      "type": "number",
      "label": "Coût variable",
      "placeholder": "Exemple de coût variable",
      "required": true
    },
    {
      "name": "cout-fix",
      "type": "number",
      "label": "Coût fixe",
      "placeholder": "Exemple de coût fixe",
      "required": true
    },
    {
      "name": "taux-de-marge",
      "type": "number",
      "label": "Taux de marge",
      "placeholder": "Exemple de taux de marge",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en finance. L'utilisateur a répondu : Société: {societe}, Activité: {activite}, Coût variable: {cout-variable}, Coût fixe: {cout-fix}, Taux de marge: {taux-de-marge}. Calcule le prix de transfert intra-groupe et donne un score global sur 100, une évaluation par axe, et des recommandations.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "score_global": {
        "type": "number",
        "description": "Score sur 100"
      },
      "axes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "axe": {
              "type": "string"
            },
            "score": {
              "type": "number",
              "description": "Score sur 100"
            }
          }
        }
      },
      "recommandations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}