{
  "id": "etude-risques-opportunites-projet",
  "title": "Étude des risques et opportunités d'un projet",
  "category": "ÉTUDES DE PROJETS & FAISABILITÉ",
  "inputs": [
    {
      "name": "project_name",
      "type": "text",
      "label": "Nom du projet",
      "placeholder": "Exemple : Projet Alpha",
      "required": true
    },
    {
      "name": "project_description",
      "type": "textarea",
      "label": "Description du projet",
      "placeholder": "Exemple : Développement d'une application mobile",
      "required": true
    },
    {
      "name": "industry",
      "type": "select",
      "options": [
        "Technologie",
        "Construction",
        "Santé",
        "Finance",
        "Autre"
      ],
      "label": "Secteur d'activité",
      "placeholder": "Sélectionnez un secteur",
      "required": true
    },
    {
      "name": "budget_estimate",
      "type": "number",
      "label": "Estimation du budget (en €)",
      "placeholder": "Exemple : 500000",
      "required": true
    },
    {
      "name": "timeline_months",
      "type": "number",
      "label": "Durée prévue (en mois)",
      "placeholder": "Exemple : 12",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un consultant expert. L'utilisateur a répondu : Project Name: {project_name}, Project Description: {project_description}, Industry: {industry}, Budget Estimate: {budget_estimate}, Timeline (months): {timeline_months}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
