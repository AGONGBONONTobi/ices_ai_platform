{
  "id": "outil-de-gestion-des-risques-de-credit-portefeuille",
  "title": "Outil de gestion des risques de crédit portefeuille",
  "category": "GESTION DES RISQUES",
  "inputs": [
    {
      "name": "montant-emprunteur",
      "type": "number",
      "label": "Montant emprunté par l'emprunteur",
      "placeholder": "Exemple : 10000",
      "required": true
    },
    {
      "name": "taux-d-interet",
      "type": "number",
      "label": "Taux d'intérêt appliqué",
      "placeholder": "Exemple : 10",
      "required": true
    },
    {
      "name": "duree-emprunt",
      "type": "number",
      "label": "Durée de l'emprunt (en mois)",
      "placeholder": "Exemple : 60",
      "required": true
    },
    {
      "name": "situation-financiere-emprunteur",
      "type": "textarea",
      "label": "Situation financière de l'emprunteur",
      "placeholder": "Exemple : ...",
      "required": true
    },
    {
      "name": "historique-credit-emprunteur",
      "type": "select",
      "options": [
        "Très bon",
        "Bon",
        "Moyen",
        "Mauvais"
      ],
      "label": "Historique de crédit de l'emprunteur",
      "placeholder": "Exemple : ...",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en gestion des risques de crédit. L'utilisateur a répondu : Montant emprunté : {montant-emprunteur}, Taux d'intérêt : {taux-d-interet}, Durée de l'emprunt : {duree-emprunt}, Situation financière de l'emprunteur : {situation-financiere-emprunteur}, Historique de crédit de l'emprunteur : {historique-credit-emprunteur}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "synthese": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "titre": {
              "type": "string"
            },
            "contenu": {
              "type": "string"
            }
          },
          "required": [
            "titre",
            "contenu"
          ]
        }
      },
      "points_cles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "synthese",
      "sections",
      "points_cles"
    ]
  },
  "output_kind": "analysis"
}
