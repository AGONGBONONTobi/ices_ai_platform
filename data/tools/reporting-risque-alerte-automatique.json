{
  "id": "reporting-risque-alerte-automatique",
  "title": "Reporting de risques & alertes automatiques",
  "category": "REPORTING & ANALYTICS DASHBOARD",
  "inputs": [
    {
      "name": "type_risque",
      "type": "select",
      "options": [
        "Cyber",
        "Financier",
        "Environnemental"
      ],
      "label": "Quel type de risque souhaitez-vous évaluer ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "severite_risque",
      "type": "number",
      "label": "Quelle est la sévérité du risque (échelle 1-5) ?",
      "placeholder": "",
      "required": true
    },
    {
      "name": "description_risque",
      "type": "textarea",
      "label": "Veuillez décrire le risque identifié",
      "placeholder": "",
      "required": true
    },
    {
      "name": "date_detection",
      "type": "text",
      "label": "Quand a-t-on détecté ce risque ?",
      "placeholder": "",
      "required": true
    }
  ],
  "promptTemplate": "Tu es un expert en reporting de risques. L'utilisateur a répondu : Type de risque : {type_risque}, Sévérité du risque : {severite_risque}, Description du risque : {description_risque}, Date de détection : {date_detection}.",
  "outputSchema": {
    "type": "object",
    "properties": {
      "colonnes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lignes": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "colonnes",
      "lignes"
    ]
  },
  "output_kind": "table"
}
