# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (LLM) ---
GROQ_API_KEY=
# Modèle par défaut : rapide et gratuit.
GROQ_MODEL=llama-3.1-8b-instant
# Modèle des outils exigeants (diagnostics adossés à un référentiel, documents).
# Indispensable : le modèle par défaut ne peut pas absorber un référentiel
# complet dans la limite de tokens/minute du palier gratuit.
GROQ_MODEL_CAPABLE=llama-3.3-70b-versatile
MODEL_ROUTING_ENABLED=true

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Quotas ---
FREE_TIER_LIMIT=50

# --- Limitation de débit ---
# Complète le quota : protège contre les rafales avant toute dépense LLM.
RATE_LIMIT_ENABLED=true
EXECUTE_RATE_LIMIT=10/minute
CATALOG_RATE_LIMIT=120/minute

# --- Observabilité ---
# Vide = Sentry désactivé. Nécessite `pip install sentry-sdk`.
SENTRY_DSN=
ENVIRONMENT=development
